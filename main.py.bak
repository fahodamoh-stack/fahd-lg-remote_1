            PremiumLabel(
                text=ar(device.get("name", "LG webOS TV")),
                font_size=sp(15),
                bold=True,
            )
        )
        texts.add_widget(
            PremiumLabel(
                text=device.get("host", ""),
                tone="muted",
                font_size=sp(12),
            )
        )
        self.add_widget(texts)

        connect = PremiumButton(
            text=ar("اتصال"),
            size_hint_x=None,
            width=dp(92),
            on_release=self.connect,
        )
        self.add_widget(connect)

    def connect(self, *_):
        app = App.get_running_app()
        app.lg.connect_async(
            self.device["host"],
            self.device.get("name"),
        )
        app.navigate("home")

    def reveal(self, delay=0):
        Clock.schedule_once(
            lambda dt: Animation(
                opacity=1,
                duration=0.28,
                t="out_quad",
            ).start(self),
            delay,
        )


class DiscoveryScreen(BaseScreen):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)

        root = BoxLayout(
            orientation="vertical",
            padding=[dp(18), dp(26), dp(18), dp(20)],
            spacing=dp(13),
        )
        self.add_widget(root)

        header = BoxLayout(size_hint_y=None, height=dp(52), spacing=dp(10))
        header.add_widget(
            PremiumButton(
                text=ar("رجوع"),
                size_hint_x=None,
                width=dp(90),
                on_release=lambda b: App.get_running_app().navigate("home"),
            )
        )
        header.add_widget(
            PremiumLabel(
                text=ar("أجهزة التلفزيون"),
                font_size=sp(23),
                bold=True,
            )
        )
        root.add_widget(header)

        status_row = BoxLayout(size_hint_y=None, height=dp(48))
        self.loading = LoadingIndicator(
            size_hint=(None, None),
            size=(dp(42), dp(42)),
        )
        status_row.add_widget(self.loading)
        self.status = PremiumLabel(
            text=ar("جارٍ البحث على الشبكة المحلية..."),
            tone="secondary",
        )
        status_row.add_widget(self.status)
        root.add_widget(status_row)

        scroll = ScrollView(do_scroll_x=False)
        self.results = BoxLayout(
            orientation="vertical",
            spacing=dp(10),
            size_hint_y=None,
            padding=[0, dp(4), 0, dp(10)],
        )
        self.results.bind(minimum_height=self.results.setter("height"))
        scroll.add_widget(self.results)
        root.add_widget(scroll)

        self.search_again = PremiumButton(
            text=ar("بحث مرة أخرى"),
            on_release=lambda b: App.get_running_app().start_discovery(),
        )
        root.add_widget(self.search_again)

    def begin(self):
        self.results.clear_widgets()
        self.status.text = ar("جارٍ البحث على الشبكة المحلية...")
        self.loading.opacity = 1
        self.loading.start()

    def show_results(self, devices):
        self.loading.stop()
        self.results.clear_widgets()

        if not devices:
            self.status.text = ar("لم يتم العثور على أجهزة.")
            self.status.opacity = 0
            Animation(opacity=1, duration=0.3).start(self.status)
            return

        self.status.text = ar("اختر تلفزيون LG webOS للاتصال")
        for index, device in enumerate(devices):
            card = DeviceCard(device)
            self.results.add_widget(card)
            card.reveal(index * 0.07)


