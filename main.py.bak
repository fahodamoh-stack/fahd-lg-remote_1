        )
        outer.add_widget(self.touchpad)

        middle = BoxLayout(size_hint_y=None, height=dp(184), spacing=dp(12))
        self.dpad = DPad()
        middle.add_widget(self.dpad)

        volume = SurfaceBox(
            orientation="vertical",
            size_hint_x=None,
            width=dp(86),
            padding=dp(8),
            spacing=dp(7),
        )
        volume.add_widget(
            PremiumButton(
                text="VOL +",
                on_release=lambda b: App.get_running_app().lg.volume_up(),
            )
        )
        volume.add_widget(
            PremiumButton(
                text="VOL -",
                on_release=lambda b: App.get_running_app().lg.volume_down(),
            )
        )
        middle.add_widget(volume)
        outer.add_widget(middle)

        extras = BoxLayout(size_hint_y=None, height=dp(54), spacing=dp(8))
        extras.add_widget(
            PremiumButton(
                text=ar("رجوع"),
                on_release=lambda b: App.get_running_app().lg.button("BACK"),
            )
        )
        extras.add_widget(
            PremiumButton(
                text=ar("الرئيسية"),
                on_release=lambda b: App.get_running_app().lg.button("HOME"),
            )
        )
        extras.add_widget(
            PremiumButton(
                text=ar("تشغيل"),
                on_release=lambda b: App.get_running_app().lg.button("PLAY"),
            )
        )
        outer.add_widget(extras)

        outer.add_widget(Widget(size_hint_y=0.25))
        self.nav = BottomNav(active="remote")
        outer.add_widget(self.nav)

    def power_off(self, *_):
        app = App.get_running_app()
        self.power.text = ar("جارٍ التنفيذ")
        app.lg.request_async(
            "ssap://system/turnOff",
            success=lambda result: self._power_done(),
            failure=lambda exc: self._power_failed(),
        )

    def _power_done(self):
        self.power.text = ar("تم الإرسال")
        Clock.schedule_once(
            lambda dt: setattr(self.power, "text", ar("إيقاف")),
            1.1,
        )

    def _power_failed(self):
        self.power.text = ar("إيقاف")
        App.get_running_app().toast("تعذر إرسال أمر إيقاف التشغيل")

    def on_pre_enter(self, *args):
        if not App.get_running_app().lg.connected:
            Clock.schedule_once(
                lambda dt: App.get_running_app().navigate("home"),
                0,
            )
            return

        self.connection.opacity = 0
        self.touchpad.opacity = 0
        self.dpad.opacity = 0
        self.nav.opacity = 0

        Animation(opacity=1, duration=0.23).start(self.connection)
        Clock.schedule_once(
            lambda dt: Animation(opacity=1, duration=0.30).start(self.touchpad),
            0.05,
        )
        Clock.schedule_once(
            lambda dt: Animation(opacity=1, duration=0.27).start(self.dpad),
            0.11,
        )
        Clock.schedule_once(
            lambda dt: Animation(opacity=1, duration=0.23).start(self.nav),
            0.18,
        )


class SettingsScreen(BaseScreen):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)

        outer = BoxLayout(
            orientation="vertical",
            padding=[dp(18), dp(25), dp(18), dp(15)],
            spacing=dp(13),
        )
        self.add_widget(outer)

        outer.add_widget(
            PremiumLabel(
                text=ar("الإعدادات"),
                font_size=sp(25),
                bold=True,
                size_hint_y=None,
                height=dp(52),
            )
        )

        self.theme_card = SurfaceBox(
            orientation="horizontal",
            padding=dp(18),
            spacing=dp(12),
            size_hint_y=None,
            height=dp(88),
        )
        labels = BoxLayout(orientation="vertical")
        labels.add_widget(
            PremiumLabel(
                text=ar("المظهر الفاتح"),
                font_size=sp(15),
                bold=True,
            )
        )
        labels.add_widget(
            PremiumLabel(
                text=ar("تبديل لوحة الألوان بالكامل"),
                tone="muted",
                font_size=sp(12),
            )
        )
        self.theme_card.add_widget(labels)

        self.theme_switch = PremiumSwitch(callback=self.change_theme)
        holder = AnchorLayout(
            anchor_x="center",
            anchor_y="center",
            size_hint_x=None,
            width=dp(70),
        )
        holder.add_widget(self.theme_switch)
        self.theme_card.add_widget(holder)
        outer.add_widget(self.theme_card)

        connection_card = SurfaceBox(
            orientation="vertical",
            padding=dp(16),
            spacing=dp(8),
            size_hint_y=None,
            height=dp(150),
        )
        connection_card.add_widget(
            PremiumLabel(
                text=ar("التلفزيون"),
                font_size=sp(16),
                bold=True,
                size_hint_y=None,
                height=dp(30),
            )
        )
        connection_card.add_widget(
            PremiumButton(
                text=ar("البحث عن تلفزيون جديد"),
                on_release=lambda b: App.get_running_app().start_discovery(),
            )
        )
        outer.add_widget(connection_card)

        profile_card = SurfaceBox(
            orientation="vertical",
            padding=dp(16),
            spacing=dp(8),
            size_hint_y=None,
            height=dp(158),
        )
        profile_card.add_widget(
            PremiumLabel(
                text=ar("الاسم"),
                font_size=sp(15),
                bold=True,
                size_hint_y=None,
                height=dp(28),
            )
        )
        self.name = PremiumInput()
        profile_card.add_widget(self.name)
        profile_card.add_widget(
            PremiumButton(
                text=ar("حفظ"),
                on_release=self.save_name,
            )
        )
        outer.add_widget(profile_card)

        outer.add_widget(Widget())
        self.nav = BottomNav(active="settings")
        outer.add_widget(self.nav)

    def on_pre_enter(self, *args):
        app = App.get_running_app()
        self.name.text = app.config_data.get("user_name", "")
        self.theme_switch.active = app.theme.mode == "light"
        self.theme_card.opacity = 0
        Animation(opacity=1, duration=0.28, t="out_quad").start(self.theme_card)

    def change_theme(self, active):
        app = App.get_running_app()
        mode = "light" if active else "dark"
        app.theme.set_mode(mode)
        app.config_data["theme"] = mode
        app.save_config()

    def save_name(self, *_):
        name = self.name.text.strip()
        if not name:
            App.get_running_app().toast("الاسم لا يمكن أن يكون فارغًا")
            return
        app = App.get_running_app()
        app.config_data["user_name"] = name
        app.save_config()
        app.home.refresh()
        app.toast("تم الحفظ")


class Toast(FloatLayout, ThemedWidget):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.size_hint = (1, 1)
        self.opacity = 0

        self.card = SurfaceBox(
            size_hint=(0.86, None),
            height=dp(58),
            pos_hint={"center_x": 0.5, "y": 0.055},
            padding=[dp(18), dp(8)],
        )
        self.label = PremiumLabel(
            text="",
            tone="text",
            halign="center",
            font_size=sp(13),
        )
        self.card.add_widget(self.label)
        self.add_widget(self.card)

    def show(self, text):
        self.label.text = ar(text)
        Animation.cancel_all(self)
        self.opacity = 0
        Animation(opacity=1, duration=0.18, t="out_quad").start(self)
        Clock.schedule_once(self.hide, 2.25)

    def hide(self, dt):
        Animation(opacity=0, duration=0.24, t="out_quad").start(self)


class Root(FloatLayout):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.manager = ScreenManager(transition=FadeTransition(duration=0.20))
        self.add_widget(self.manager)
        self.toast_widget = Toast()
        self.add_widget(self.toast_widget)


class PremiumRemoteApp(App):
    def build(self):
        self.title = APP_NAME
        self.config_data = self.load_config()
        self.theme = ThemeManager(self.config_data.get("theme", "dark"))
        self.lg = LGWebOSClient(self.config_data, self.on_tv_state)

        root = Root()
        self.root_widget = root
        sm = root.manager

        self.splash = SplashScreen(name="splash")
        self.welcome = WelcomeScreen(name="welcome")
        self.home = HomeScreen(name="home")
        self.discovery = DiscoveryScreen(name="discovery")
        self.remote = RemoteScreen(name="remote")
        self.settings = SettingsScreen(name="settings")

        for screen in (
            self.splash,
            self.welcome,
            self.home,
            self.discovery,
            self.remote,
            self.settings,
        ):
            sm.add_widget(screen)

        sm.current = "splash"
        Clock.schedule_once(lambda dt: self.splash.start(), 0.15)

        last_tv = self.config_data.get("last_tv")
        if last_tv and last_tv.get("host"):
            Clock.schedule_once(
                lambda dt: self.lg.connect_async(
                    last_tv["host"],
                    last_tv.get("name"),
                ),
                1.8,
            )

        return root

    def navigate(self, name):
        if not self.root_widget:
            return
        if name not in self.root_widget.manager.screen_names:
            return
        self.root_widget.manager.current = name
        screen = self.root_widget.manager.get_screen(name)
        try:
            screen.animate_in()
        except Exception:
            pass

    def toast(self, text):
        if self.root_widget:
            self.root_widget.toast_widget.show(text)

    def start_discovery(self):
        self.navigate("discovery")
        self.discovery.begin()
        self.home.tv_card.update_state("searching")

        def worker():
            try:
                devices = LGWebOSClient.discover(timeout=3.2)
                Clock.schedule_once(
                    lambda dt: self._discovery_complete(devices),
                    0,
                )
            except Exception:
                Clock.schedule_once(
                    lambda dt: self._discovery_complete([]),
                    0,
                )

        threading.Thread(target=worker, daemon=True).start()

    def _discovery_complete(self, devices):
        self.discovery.show_results(devices)
        if not self.lg.connected:
            self.home.tv_card.update_state("disconnected")

    def on_tv_state(self, state, message):
        self.home.tv_card.update_state(state, message)

        if state == "connected":
            self.toast("تم الاتصال بالتلفزيون")
        elif state == "error":
            self.toast(message)
        elif state == "connecting":
            self.home.tv_card.update_state("connecting")

    def load_config(self):
        try:
            if CONFIG_FILE.exists():
                with CONFIG_FILE.open("r", encoding="utf-8") as f:
                    data = json.load(f)
                    if isinstance(data, dict):
                        return data
        except Exception:
            pass

        return {
            "theme": "dark",
            "user_name": "",
            "client_keys": {},
        }

    def save_config(self):
        try:
            CONFIG_DIR.mkdir(parents=True, exist_ok=True)
            with CONFIG_FILE.open("w", encoding="utf-8") as f:
                json.dump(
                    self.config_data,
                    f,
                    ensure_ascii=False,
                    indent=2,
                )
        except Exception:
            pass

    def on_stop(self):
        try:
            self.lg.disconnect(notify=False)
        except Exception:
            pass


if __name__ == "__main__":
    PremiumRemoteApp().run()
