class RemoteScreen(BaseScreen):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)

        outer = BoxLayout(
            orientation="vertical",
            padding=[dp(16), dp(20), dp(16), dp(14)],
            spacing=dp(11),
        )
        self.add_widget(outer)

        header = BoxLayout(size_hint_y=None, height=dp(46))
        self.connection = PremiumLabel(
            text=ar("الريموت"),
            font_size=sp(22),
            bold=True,
        )
        header.add_widget(self.connection)

        self.power = PremiumButton(
