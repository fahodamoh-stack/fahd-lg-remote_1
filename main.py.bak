try:
    import arabic_reshaper
    from bidi.algorithm import get_display

    def ar(text):
        if not text:
            return ""
        try:
            return get_display(arabic_reshaper.reshape(str(text)))
        except Exception:
            return str(text)
except Exception:
    def ar(text):
        return str(text)


Window.minimum_width = 340
Window.minimum_height = 600

APP_NAME = "Premium LG Remote"
CONFIG_DIR = Path.home() / ".premium_lg_remote"
CONFIG_FILE = CONFIG_DIR / "config.json"


def clamp(value, lo, hi):
    return max(lo, min(hi, value))


def rgba(hex_value, alpha=1.0):
    value = hex_value.lstrip("#")
    if len(value) == 6:
        r = int(value[0:2], 16) / 255.0
        g = int(value[2:4], 16) / 255.0
        b = int(value[4:6], 16) / 255.0
        return [r, g, b, alpha]
    return [1, 1, 1, alpha]


class ThemeManager:
    DARK = {
        "background": rgba("#07090D"),
        "surface": rgba("#0E1117"),
        "elevated": rgba("#151922"),
        "soft": rgba("#1B2029"),
        "text": rgba("#F2F4F7"),
        "secondary": rgba("#A7ADB8"),
        "muted": rgba("#737B88"),
        "border": rgba("#252B35"),
        "connected": rgba("#55C98A"),
        "danger": rgba("#B94A55"),
        "accent": rgba("#8EA7C7"),
        "input": rgba("#11151C"),
    }

    LIGHT = {
        "background": rgba("#EEF1F5"),
        "surface": rgba("#F8F9FB"),
        "elevated": rgba("#FFFFFF"),
        "soft": rgba("#E7EBF0"),
        "text": rgba("#20252D"),
        "secondary": rgba("#59616D"),
        "muted": rgba("#7D8693"),
        "border": rgba("#D6DBE2"),
        "connected": rgba("#318D61"),
        "danger": rgba("#A7444E"),
        "accent": rgba("#637E9F"),
        "input": rgba("#F2F4F7"),
    }

    def __init__(self, mode="dark"):
        self.mode = mode
        self.listeners = []

    def get(self, name):
        return (self.DARK if self.mode == "dark" else self.LIGHT)[name]

    def register(self, widget):
        if widget not in self.listeners:
            self.listeners.append(widget)

    def toggle(self):
        self.mode = "light" if self.mode == "dark" else "dark"
        self.refresh()

    def set_mode(self, mode):
        self.mode = mode if mode in ("dark", "light") else "dark"
        self.refresh()

    def refresh(self):
        for widget in self.listeners[:]:
            try:
                widget.apply_theme(animated=True)
            except Exception:
                try:
                    self.listeners.remove(widget)
                except ValueError:
                    pass


class ThemedWidget:
    def register_theme(self):
        app = App.get_running_app()
        if app and hasattr(app, "theme"):
            app.theme.register(self)

    def color(self, key):
        app = App.get_running_app()
        if app and hasattr(app, "theme"):
            return app.theme.get(key)
        return ThemeManager.DARK[key]


class SurfaceBox(BoxLayout, ThemedWidget):
    radius = NumericProperty(dp(22))
    surface_key = StringProperty("surface")
    border_key = StringProperty("border")
    border_width = NumericProperty(dp(1))

    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        with self.canvas.before:
            self._bg_color = Color(*ThemeManager.DARK["surface"])
            self._bg = RoundedRectangle(pos=self.pos, size=self.size, radius=[self.radius])
            self._border_color = Color(*ThemeManager.DARK["border"])
            self._border = Line(
                rounded_rectangle=(self.x, self.y, self.width, self.height, self.radius),
                width=self.border_width,
            )
        self.bind(pos=self._sync_canvas, size=self._sync_canvas, radius=self._sync_canvas)
        Clock.schedule_once(lambda dt: self.register_theme(), 0)

    def _sync_canvas(self, *args):
        self._bg.pos = self.pos
        self._bg.size = self.size
        self._bg.radius = [self.radius]
        self._border.rounded_rectangle = (
            self.x, self.y, self.width, self.height, self.radius
        )

    def apply_theme(self, animated=False):
        self._bg_color.rgba = self.color(self.surface_key)
        self._border_color.rgba = self.color(self.border_key)


class PremiumLabel(Label, ThemedWidget):
    tone = StringProperty("text")

    def __init__(self, **kwargs):
        kwargs.setdefault("font_size", sp(14))
        kwargs.setdefault("halign", "right")
        kwargs.setdefault("valign", "middle")
        super().__init__(**kwargs)
        self.bind(size=self._text_size)
        Clock.schedule_once(lambda dt: self.register_theme(), 0)
        Clock.schedule_once(lambda dt: self.apply_theme(), 0)

    def _text_size(self, *args):
        self.text_size = (self.width, None)

    def apply_theme(self, animated=False):
        target = self.color(self.tone)
        if animated:
            Animation(color=target, duration=0.18, t="out_quad").start(self)
        else:
            self.color = target


class PremiumButton(Widget, ThemedWidget):
    text = StringProperty("")
    disabled = BooleanProperty(False)
    accent_key = StringProperty("soft")
    text_key = StringProperty("text")
    scale_value = NumericProperty(1.0)
    pressed = BooleanProperty(False)

    def __init__(self, on_release=None, **kwargs):
        super().__init__(**kwargs)
        self.on_release_callback = on_release
        self.size_hint_y = kwargs.get("size_hint_y", None)
        if self.size_hint_y is None:
            self.height = kwargs.get("height", dp(54))

        with self.canvas.before:
            self._shadow_color = Color(0, 0, 0, 0.16)
            self._shadow = RoundedRectangle(radius=[dp(17)])
            self._bg_color = Color(*ThemeManager.DARK["soft"])
            self._bg = RoundedRectangle(radius=[dp(17)])
            self._border_color = Color(*ThemeManager.DARK["border"])
            self._border = Line(width=dp(1), rounded_rectangle=(0, 0, 1, 1, dp(17)))

        self._label = Label(
            text=ar(self.text),
            font_size=sp(14),
            bold=True,
            halign="center",
            valign="middle",
        )
        self.add_widget(self._label)
        self.bind(pos=self._sync, size=self._sync, text=self._sync_text)
        self.bind(scale_value=self._sync)
        Clock.schedule_once(lambda dt: self.register_theme(), 0)
        Clock.schedule_once(lambda dt: self.apply_theme(), 0)

    def _sync_text(self, *args):
        self._label.text = ar(self.text)

    def _sync(self, *args):
        w = self.width * self.scale_value
        h = self.height * self.scale_value
        x = self.center_x - w / 2
        y = self.center_y - h / 2
        self._shadow.pos = (x, y - dp(2))
        self._shadow.size = (w, h)
        self._bg.pos = (x, y)
        self._bg.size = (w, h)
        self._border.rounded_rectangle = (x, y, w, h, dp(17))
        self._label.pos = (x, y)
        self._label.size = (w, h)
        self._label.text_size = (w, h)

    def apply_theme(self, animated=False):
        self._bg_color.rgba = self.color(self.accent_key)
        self._border_color.rgba = self.color("border")
        self._label.color = self.color(self.text_key)

    def on_touch_down(self, touch):
        if self.disabled or not self.collide_point(*touch.pos):
            return super().on_touch_down(touch)
        self.pressed = True
        touch.grab(self)
        Animation.cancel_all(self, "scale_value")
        Animation(scale_value=0.965, duration=0.08, t="out_quad").start(self)
        return True

    def on_touch_up(self, touch):
        if touch.grab_current is not self:
            return super().on_touch_up(touch)
        touch.ungrab(self)
        was_inside = self.collide_point(*touch.pos)
        self.pressed = False
        Animation.cancel_all(self, "scale_value")
        Animation(scale_value=1.0, duration=0.14, t="out_back").start(self)
        if was_inside and not self.disabled and self.on_release_callback:
            Clock.schedule_once(lambda dt: self.on_release_callback(self), 0.01)
        return True


class StatusDot(Widget, ThemedWidget):
    state = StringProperty("disconnected")
    pulse = NumericProperty(0)

    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        with self.canvas:
            self._glow_color = Color(0, 0, 0, 0)
            self._glow = Ellipse()
            self._dot_color = Color(*ThemeManager.DARK["muted"])
            self._dot = Ellipse()
            self._ring_color = Color(*ThemeManager.DARK["border"])
            self._ring = Line(circle=(0, 0, 1), width=dp(1))
        self.bind(pos=self._sync, size=self._sync, pulse=self._sync)
        Clock.schedule_once(lambda dt: self.register_theme(), 0)
        Clock.schedule_once(lambda dt: self.set_state(self.state), 0)

    def _sync(self, *args):
        radius = min(self.width, self.height) * 0.24
        glow_r = radius * (1.8 + self.pulse * 0.28)
        self._dot.pos = (self.center_x - radius, self.center_y - radius)
        self._dot.size = (radius * 2, radius * 2)
        self._glow.pos = (self.center_x - glow_r, self.center_y - glow_r)
        self._glow.size = (glow_r * 2, glow_r * 2)
        self._ring.circle = (
            self.center_x,
            self.center_y,
            radius * (1.55 + self.pulse * 0.12),
        )

    def set_state(self, state):
        self.state = state
        Animation.cancel_all(self, "pulse")
        if state == "connected":
            c = self.color("connected")
            self._dot_color.rgba = c
            self._glow_color.rgba = [c[0], c[1], c[2], 0.10]
            self._ring_color.rgba = [c[0], c[1], c[2], 0.28]
            Animation(pulse=0.35, duration=0.35, t="out_quad").start(self)
        elif state in ("searching", "connecting"):
            c = self.color("accent")
            self._dot_color.rgba = c
            self._glow_color.rgba = [c[0], c[1], c[2], 0.07]
            self._ring_color.rgba = [c[0], c[1], c[2], 0.30]
            (
                Animation(pulse=1, duration=0.65, t="in_out_quad")
                + Animation(pulse=0, duration=0.65, t="in_out_quad")
            ).repeat = True
            anim = (
                Animation(pulse=1, duration=0.65, t="in_out_quad")
                + Animation(pulse=0, duration=0.65, t="in_out_quad")
            )
            anim.repeat = True
            anim.start(self)
        else:
            self._dot_color.rgba = self.color("muted")
            self._glow_color.rgba = [0, 0, 0, 0]
            self._ring_color.rgba = self.color("border")

    def apply_theme(self, animated=False):
        self.set_state(self.state)


class PremiumInput(TextInput, ThemedWidget):
    def __init__(self, **kwargs):
        kwargs.setdefault("multiline", False)
        kwargs.setdefault("font_size", sp(16))
        kwargs.setdefault("padding", [dp(18), dp(15)])
        super().__init__(**kwargs)
        self.background_normal = ""
        self.background_active = ""
        self.border = [0, 0, 0, 0]
        self.cursor_width = dp(1.2)
        self.size_hint_y = None
        self.height = dp(56)
        Clock.schedule_once(lambda dt: self.register_theme(), 0)
        Clock.schedule_once(lambda dt: self.apply_theme(), 0)

    def apply_theme(self, animated=False):
        self.background_color = self.color("input")
        self.foreground_color = self.color("text")
        self.hint_text_color = self.color("muted")
        self.cursor_color = self.color("accent")


class PremiumSwitch(Widget, ThemedWidget):
    active = BooleanProperty(False)
    thumb_x = NumericProperty(0)

    def __init__(self, callback=None, **kwargs):
        super().__init__(**kwargs)
        self.callback = callback
        self.size_hint = (None, None)
        self.size = (dp(52), dp(30))
        with self.canvas:
            self._track_color = Color(*ThemeManager.DARK["soft"])
            self._track = RoundedRectangle(radius=[dp(15)])
            self._thumb_color = Color(*ThemeManager.DARK["text"])
            self._thumb = Ellipse()
        self.bind(pos=self._sync, size=self._sync, thumb_x=self._sync)
        self.bind(active=self._active_changed)
        Clock.schedule_once(lambda dt: self.register_theme(), 0)
        Clock.schedule_once(lambda dt: self._set_thumb(False), 0)

    def _sync(self, *args):
        self._track.pos = self.pos
        self._track.size = self.size
        d = self.height - dp(8)
        x = self.x + dp(4) + self.thumb_x * (self.width - d - dp(8))
        self._thumb.pos = (x, self.y + dp(4))
        self._thumb.size = (d, d)

    def _set_thumb(self, animate=True):
        target = 1 if self.active else 0
        if animate:
            Animation.cancel_all(self, "thumb_x")
            Animation(thumb_x=target, duration=0.17, t="out_cubic").start(self)
        else:
            self.thumb_x = target

    def _active_changed(self, *args):
        self._set_thumb(True)
        self.apply_theme(True)

    def apply_theme(self, animated=False):
        c = self.color("accent") if self.active else self.color("soft")
        self._track_color.rgba = c
        self._thumb_color.rgba = self.color("text")

    def on_touch_down(self, touch):
        if self.collide_point(*touch.pos):
            self.active = not self.active
            if self.callback:
                self.callback(self.active)
            return True
        return super().on_touch_down(touch)


class LoadingIndicator(Widget, ThemedWidget):
    angle = NumericProperty(0)
    running = BooleanProperty(False)

    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        with self.canvas:
            self._track_color = Color(*ThemeManager.DARK["border"])
            self._track = Line(circle=(0, 0, 1, 0, 360), width=dp(2))
            self._arc_color = Color(*ThemeManager.DARK["accent"])
            self._arc = Line(circle=(0, 0, 1, 0, 90), width=dp(2.2))
        self.bind(pos=self._sync, size=self._sync, angle=self._sync)
        Clock.schedule_once(lambda dt: self.register_theme(), 0)

    def _sync(self, *args):
        r = max(dp(6), min(self.width, self.height) / 2 - dp(4))
        self._track.circle = (self.center_x, self.center_y, r, 0, 360)
        self._arc.circle = (self.center_x, self.center_y, r, self.angle, self.angle + 95)

    def start(self):
        self.running = True
        self.opacity = 1
        Animation.cancel_all(self, "angle")
        anim = Animation(angle=360, duration=0.9, t="linear")
        anim.repeat = True
        anim.start(self)

    def stop(self):
        self.running = False
        Animation.cancel_all(self, "angle")
        Animation(opacity=0, duration=0.18, t="out_quad").start(self)

    def apply_theme(self, animated=False):
        self._track_color.rgba = self.color("border")
        self._arc_color.rgba = self.color("accent")


class BottomNav(SurfaceBox):
    def __init__(self, active="home", **kwargs):
        super().__init__(orientation="horizontal", spacing=dp(6), padding=dp(7), **kwargs)
        self.size_hint_y = None
        self.height = dp(68)
        self.radius = dp(22)
        self.active = active
        self.buttons = {}

        items = [
            ("settings", "الإعدادات"),
            ("home", "الرئيسية"),
            ("remote", "الريموت"),
        ]
        for key, text in items:
            btn = PremiumButton(
                text=ar(text),
                accent_key="elevated" if key == active else "surface",
                on_release=lambda b, k=key: self.navigate(k),
            )
            self.buttons[key] = btn
            self.add_widget(btn)

    def navigate(self, screen):
        app = App.get_running_app()
        if screen == "remote" and not app.lg.connected:
            app.toast("اتصل بالتلفزيون أولاً")
            return
        for key, button in self.buttons.items():
            button.accent_key = "elevated" if key == screen else "surface"
            button.apply_theme()
        app.navigate(screen)


class BaseScreen(Screen, ThemedWidget):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        with self.canvas.before:
            self._bg_color = Color(*ThemeManager.DARK["background"])
            self._bg = Rectangle(pos=self.pos, size=self.size)
        self.bind(pos=self._sync, size=self._sync)
        Clock.schedule_once(lambda dt: self.register_theme(), 0)

    def _sync(self, *args):
        self._bg.pos = self.pos
        self._bg.size = self.size

    def apply_theme(self, animated=False):
        self._bg_color.rgba = self.color("background")

    def animate_in(self):
        self.opacity = 0
        Animation(opacity=1, duration=0.22, t="out_quad").start(self)


class LGWebOSClient:
    REGISTER_PAYLOAD = {
        "forcePairing": False,
        "pairingType": "PROMPT",
        "manifest": {
            "manifestVersion": 1,
            "appVersion": "1.1",
            "signed": {
                "created": "20140509",
                "appId": "com.lge.test",
                "vendorId": "com.lge",
                "localizedAppNames": {
                    "": "LG Remote App",
                },
                "localizedVendorNames": {
                    "": "OpenAI Remote",
                },
                "permissions": [
                    "TEST_SECURE",
                    "CONTROL_INPUT_TEXT",
                    "CONTROL_MOUSE_AND_KEYBOARD",
                    "READ_INSTALLED_APPS",
                    "READ_LGE_SDX",
                    "READ_NOTIFICATIONS",
                    "SEARCH",
                    "WRITE_SETTINGS",
                    "WRITE_NOTIFICATION_ALERT",
                    "CONTROL_POWER",
                    "READ_CURRENT_CHANNEL",
                    "READ_RUNNING_APPS",
                    "READ_UPDATE_INFO",
                    "UPDATE_FROM_REMOTE_APP",
                    "READ_LGE_TV_INPUT_EVENTS",
                    "READ_TV_CURRENT_TIME",
                ],
                "serial": "2f930e2d2cfe083771f68e4fe7bb07",
            },
            "permissions": [
                "LAUNCH",
                "LAUNCH_WEBAPP",
                "APP_TO_APP",
                "CLOSE",
                "TEST_OPEN",
                "TEST_PROTECTED",
                "CONTROL_AUDIO",
                "CONTROL_DISPLAY",
                "CONTROL_INPUT_JOYSTICK",
                "CONTROL_INPUT_MEDIA_RECORDING",
                "CONTROL_INPUT_MEDIA_PLAYBACK",
                "CONTROL_INPUT_TV",
                "CONTROL_POWER",
                "READ_APP_STATUS",
                "READ_CURRENT_CHANNEL",
                "READ_INPUT_DEVICE_LIST",
                "READ_NETWORK_STATE",
                "READ_RUNNING_APPS",
                "READ_TV_CHANNEL_LIST",
                "WRITE_NOTIFICATION_TOAST",
                "READ_POWER_STATE",
                "READ_COUNTRY_INFO",
            ],
            "signatures": [
                {
                    "signatureVersion": 1,
                    "signature": "eyJhbGciOiJSUzI1NiJ9."
                    "eyJpc3MiOiJjb20ubGdlIiwiYXVkIjoiY29tLmxnZSIsImV4cCI6MT"
                    "g5MzQ1NjAwMCwiaWF0IjoxNDAwMDAwMDAwfQ."
                    "signature"
                }
            ],
        },
    }

    def __init__(self, config, on_state=None):
        self.config = config
        self.on_state = on_state
        self.ws = None
        self.pointer_ws = None
        self.host = None
        self.name = None
        self.connected = False
        self.lock = threading.RLock()
        self.request_id = 0
        self.stop_event = threading.Event()

    def _state(self, state, message=""):
        if self.on_state:
            Clock.schedule_once(lambda dt: self.on_state(state, message), 0)

    @staticmethod
    def discover(timeout=3.0):
        message = (
            'M-SEARCH * HTTP/1.1\r\n'
            'HOST: 239.255.255.250:1900\r\n'
            'MAN: "ssdp:discover"\r\n'
            'MX: 2\r\n'
            'ST: urn:lge-com:service:webos-second-screen:1\r\n'
            '\r\n'
        ).encode("utf-8")

        devices = {}
        sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM, socket.IPPROTO_UDP)
        try:
            sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            sock.settimeout(0.35)
            sock.sendto(message, ("239.255.255.250", 1900))
            sock.sendto(
                message.replace(
                    b"urn:lge-com:service:webos-second-screen:1",
                    b"ssdp:all",
                ),
                ("239.255.255.250", 1900),
            )

            end = time.time() + timeout
            while time.time() < end:
                try:
                    data, addr = sock.recvfrom(65535)
                except socket.timeout:
                    continue

                text = data.decode("utf-8", errors="ignore")
                lower = text.lower()
                if (
                    "webos" not in lower
                    and "lge" not in lower
                    and "lg electronics" not in lower
                ):
                    continue

                headers = {}
                for line in text.split("\r\n")[1:]:
                    if ":" in line:
                        k, v = line.split(":", 1)
                        headers[k.strip().lower()] = v.strip()

                host = addr[0]
                name = (
                    headers.get("friendlyname")
                    or headers.get("server")
                    or "LG webOS TV"
                )
                devices[host] = {
                    "host": host,
                    "name": name,
                    "location": headers.get("location", ""),
                }
        finally:
            sock.close()

        return list(devices.values())

    def connect_async(self, host, name=None):
        threading.Thread(
            target=self._connect,
            args=(host, name),
            daemon=True,
        ).start()

    def _open_socket(self, host):
        last_error = None
        urls = [
            f"wss://{host}:3001/",
            f"ws://{host}:3000/",
        ]
        for url in urls:
            try:
                options = {}
                if url.startswith("wss"):
                    options["sslopt"] = {
                        "cert_reqs": ssl.CERT_NONE,
                        "check_hostname": False,
                    }
                ws = websocket.create_connection(
                    url,
                    timeout=8,
                    origin="http://localhost",
                    **options,
                )
                ws.settimeout(8)
                return ws
            except Exception as exc:
                last_error = exc
        raise last_error or ConnectionError("Unable to open TV websocket")

    def _connect(self, host, name=None):
        self.disconnect(notify=False)
        self._state("connecting", "جارٍ الاتصال بالتلفزيون...")
        try:
            ws = self._open_socket(host)
            register = {
                "type": "register",
                "id": "register_0",
                "payload": dict(self.REGISTER_PAYLOAD),
            }

            saved_key = self.config.get("client_keys", {}).get(host)
            if saved_key:
                register["payload"]["client-key"] = saved_key

            ws.send(json.dumps(register))

            deadline = time.time() + 25
            registered = False
            client_key = None

            while time.time() < deadline:
                raw = ws.recv()
                if not raw:
                    continue
                data = json.loads(raw)
                if data.get("type") == "registered":
                    client_key = data.get("payload", {}).get("client-key")
                    registered = True
                    break
                if data.get("type") == "error":
                    raise ConnectionError(data.get("error", "Registration rejected"))

            if not registered:
                raise TimeoutError("انتهت مهلة الاقتران بالتلفزيون")

            with self.lock:
                self.ws = ws
                self.host = host
                self.name = name or "LG webOS TV"
                self.connected = True

            if client_key:
                keys = self.config.setdefault("client_keys", {})
                keys[host] = client_key
                App.get_running_app().save_config()

            self.config["last_tv"] = {
                "host": host,
                "name": self.name,
            }
            App.get_running_app().save_config()

            self._state("connected", "تم الاتصال بنجاح")
            self._setup_pointer()
        except Exception as exc:
            self.connected = False
            self._state("error", self._friendly_error(exc))

    @staticmethod
    def _friendly_error(exc):
        text = str(exc)
        if "timed out" in text.lower() or isinstance(exc, TimeoutError):
            return "تعذر الاتصال. تأكد من أن التلفزيون يعمل وعلى نفس الشبكة."
        if "refused" in text.lower():
            return "رفض التلفزيون الاتصال. تحقق من الشبكة وإعدادات التلفزيون."
        return "فشل الاتصال بالتلفزيون: " + text[:100]

    def _next_id(self):
        with self.lock:
            self.request_id += 1
            return "req_" + str(self.request_id)

    def request(self, uri, payload=None, timeout=6):
        with self.lock:
            if not self.connected or not self.ws:
                raise ConnectionError("TV is not connected")

            request_id = self._next_id()
            packet = {
                "type": "request",
                "id": request_id,
                "uri": uri,
                "payload": payload or {},
            }
            self.ws.settimeout(timeout)
            self.ws.send(json.dumps(packet))

            deadline = time.time() + timeout
            while time.time() < deadline:
                raw = self.ws.recv()
                data = json.loads(raw)
                if data.get("id") != request_id:
                    continue
                if data.get("type") == "error":
                    raise RuntimeError(data.get("error", "webOS request error"))
                return data.get("payload", {})
            raise TimeoutError("webOS request timeout")

    def request_async(self, uri, payload=None, success=None, failure=None):
        def worker():
            try:
                result = self.request(uri, payload)
                if success:
                    Clock.schedule_once(lambda dt: success(result), 0)
            except Exception as exc:
                if failure:
                    Clock.schedule_once(lambda dt: failure(exc), 0)
        threading.Thread(target=worker, daemon=True).start()

    def _setup_pointer(self):
        try:
            payload = self.request("ssap://com.webos.service.networkinput/getPointerInputSocket")
            url = payload.get("socketPath")
            if not url:
                return
            options = {}
            if url.startswith("wss"):
                options["sslopt"] = {
                    "cert_reqs": ssl.CERT_NONE,
                    "check_hostname": False,
                }
            pointer = websocket.create_connection(
                url,
                timeout=6,
                origin="http://localhost",
                **options,
            )
            pointer.settimeout(5)
            with self.lock:
                self.pointer_ws = pointer
        except Exception:
            self.pointer_ws = None

    def pointer_send(self, message):
        with self.lock:
            if not self.connected:
                return
            if not self.pointer_ws:
                threading.Thread(target=self._setup_pointer, daemon=True).start()
                return
            try:
                self.pointer_ws.send(message)
            except Exception:
                try:
                    self.pointer_ws.close()
                except Exception:
                    pass
                self.pointer_ws = None

    def button(self, name):
        self.pointer_send("type:button\nname:%s\n\n" % name)

    def move(self, dx, dy):
        dx = int(clamp(dx, -250, 250))
        dy = int(clamp(dy, -250, 250))
        if dx == 0 and dy == 0:
            return
        self.pointer_send("type:move\ndx:%d\ndy:%d\ndown:0\n\n" % (dx, dy))

    def click(self):
        self.pointer_send("type:click\n\n")

    def power_off(self):
        self.request_async("ssap://system/turnOff")

    def volume_up(self):
        self.request_async("ssap://audio/volumeUp")

    def volume_down(self):
        self.request_async("ssap://audio/volumeDown")

    def mute(self):
        self.request_async("ssap://audio/setMute", {"mute": True})

    def disconnect(self, notify=True):
        with self.lock:
            for ws in (self.pointer_ws, self.ws):
                try:
                    if ws:
                        ws.close()
                except Exception:
                    pass
            self.pointer_ws = None
            self.ws = None
            self.connected = False
        if notify:
            self._state("disconnected", "غير متصل")


class TouchPad(SurfaceBox):
    touching = BooleanProperty(False)

    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.radius = dp(28)
        self.surface_key = "elevated"
        self.last_pos = None
        self.start_pos = None
        self.start_time = 0
        self._move_accum = 0

        self.label = PremiumLabel(
            text=ar("حرّك إصبعك للتحكم"),
            tone="muted",
            font_size=sp(13),
            halign="center",
        )
        self.add_widget(self.label)

    def on_touch_down(self, touch):
        if not self.collide_point(*touch.pos):
            return super().on_touch_down(touch)
        touch.grab(self)
        self.touching = True
        self.last_pos = touch.pos
        self.start_pos = touch.pos
        self.start_time = time.time()
        self._move_accum = 0
        c = self.color("accent")
        self._border_color.rgba = [c[0], c[1], c[2], 0.55]
        return True

    def on_touch_move(self, touch):
        if touch.grab_current is not self:
            return super().on_touch_move(touch)
        if self.last_pos:
            dx = (touch.x - self.last_pos[0]) * 1.25
            dy = (touch.y - self.last_pos[1]) * 1.25
            self._move_accum += abs(dx) + abs(dy)
            App.get_running_app().lg.move(dx, dy)
        self.last_pos = touch.pos
        return True

    def on_touch_up(self, touch):
        if touch.grab_current is not self:
            return super().on_touch_up(touch)
        touch.ungrab(self)
        self.touching = False
        self._border_color.rgba = self.color("border")
        if self.start_pos:
            distance = math.hypot(
                touch.x - self.start_pos[0],
                touch.y - self.start_pos[1],
            )
            if distance < dp(12) and time.time() - self.start_time < 0.45:
                App.get_running_app().lg.click()
        self.last_pos = None
        return True


class RepeatButton(PremiumButton):
    command = StringProperty("")
    repeat_event = None
    delay_event = None

    def on_touch_down(self, touch):
        handled = super().on_touch_down(touch)
        if handled and self.pressed:
            self._send()
            self.delay_event = Clock.schedule_once(self._begin_repeat, 0.38)
        return handled

    def _send(self):
        if self.command:
            App.get_running_app().lg.button(self.command)

    def _begin_repeat(self, dt):
        if self.pressed:
            self.repeat_event = Clock.schedule_interval(
                lambda x: self._send() if self.pressed else None,
                0.12,
            )

    def _cancel_repeat(self):
        if self.delay_event:
            self.delay_event.cancel()
            self.delay_event = None
        if self.repeat_event:
            self.repeat_event.cancel()
            self.repeat_event = None

    def on_touch_up(self, touch):
        mine = touch.grab_current is self
        if mine:
            self._cancel_repeat()
        result = super().on_touch_up(touch)
        return result

    def on_release_callback_dummy(self):
        pass


class SplashScreen(BaseScreen):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        root = FloatLayout()
        self.add_widget(root)

        self.logo_holder = Widget(
            size_hint=(None, None),
            size=(dp(112), dp(112)),
            pos_hint={"center_x": 0.5, "center_y": 0.59},
            opacity=0,
        )
        with self.logo_holder.canvas:
            self.logo_glow_color = Color(*rgba("#8EA7C7", 0.08))
            self.logo_glow = Ellipse()
            self.logo_ring_color = Color(*rgba("#8EA7C7", 0.55))
            self.logo_ring = Line(width=dp(2))
            self.logo_core_color = Color(*rgba("#151922"))
            self.logo_core = Ellipse()
            self.logo_line_color = Color(*rgba("#F2F4F7", 0.88))
            self.logo_line = Line(width=dp(3), cap="round")
        self.logo_holder.bind(pos=self._logo_sync, size=self._logo_sync)
        root.add_widget(self.logo_holder)

        self.text_label = PremiumLabel(
            text=ar("جارٍ تجهيز تجربتك..."),
            tone="secondary",
            font_size=sp(15),
            size_hint=(0.8, None),
            height=dp(40),
            pos_hint={"center_x": 0.5, "center_y": 0.42},
            halign="center",
            opacity=0,
        )
        root.add_widget(self.text_label)

    def _logo_sync(self, *args):
        x, y = self.logo_holder.pos
        w, h = self.logo_holder.size
        self.logo_glow.pos = (x - dp(10), y - dp(10))
        self.logo_glow.size = (w + dp(20), h + dp(20))
        self.logo_core.pos = (x + dp(12), y + dp(12))
        self.logo_core.size = (w - dp(24), h - dp(24))
        self.logo_ring.circle = (x + w / 2, y + h / 2, w * 0.38)
        self.logo_line.points = [
            x + w / 2, y + h * 0.53,
            x + w / 2, y + h * 0.74,
        ]

    def start(self):
        self.logo_holder.opacity = 0
        self.text_label.opacity = 0
        Animation(opacity=1, duration=0.45, t="out_quad").start(self.logo_holder)
        Clock.schedule_once(
            lambda dt: Animation(opacity=1, duration=0.35, t="out_quad").start(self.text_label),
            0.25,
        )
        Clock.schedule_once(self.finish, 1.45)

    def finish(self, dt):
        app = App.get_running_app()
        target = "home" if app.config_data.get("user_name") else "welcome"
        app.navigate(target)
class WelcomeScreen(BaseScreen):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        root = BoxLayout(
            orientation="vertical",
            padding=[dp(26), dp(50), dp(26), dp(34)],
            spacing=dp(15),
        )
        self.add_widget(root)

        root.add_widget(Widget(size_hint_y=0.7))

        self.title = PremiumLabel(
            text=ar("مرحبًا بك"),
            font_size=sp(30),
            bold=True,
            halign="center",
            size_hint_y=None,
            height=dp(52),
        )
        root.add_widget(self.title)

        self.subtitle = PremiumLabel(
            text=ar("تحكم هادئ وسريع بتلفزيون LG webOS"),
            tone="secondary",
            font_size=sp(14),
            halign="center",
            size_hint_y=None,
            height=dp(42),
        )
        root.add_widget(self.subtitle)

        self.name_input = PremiumInput(
            hint_text=ar("اسمك"),
        )
        root.add_widget(self.name_input)

        self.continue_button = PremiumButton(
            text=ar("متابعة"),
            accent_key="accent",
            text_key="background",
            on_release=self.continue_pressed,
            height=dp(56),
        )
        root.add_widget(self.continue_button)
        root.add_widget(Widget(size_hint_y=1))

    def on_pre_enter(self, *args):
        self.title.opacity = 0
        self.subtitle.opacity = 0
        self.name_input.opacity = 0
        self.continue_button.opacity = 0

        Animation(opacity=1, duration=0.30, t="out_quad").start(self.title)
        Clock.schedule_once(
            lambda dt: Animation(opacity=1, duration=0.28).start(self.subtitle),
            0.08,
        )
        Clock.schedule_once(
            lambda dt: Animation(opacity=1, duration=0.28).start(self.name_input),
            0.16,
        )
        Clock.schedule_once(
            lambda dt: Animation(opacity=1, duration=0.28).start(self.continue_button),
            0.24,
        )

    def continue_pressed(self, *_):
        name = self.name_input.text.strip()
        if not name:
            App.get_running_app().toast("اكتب اسمك للمتابعة")
            return
        app = App.get_running_app()
        app.config_data["user_name"] = name
        app.save_config()
        app.home.refresh()
        app.navigate("home")


class TVCard(SurfaceBox):
    def __init__(self, **kwargs):
        super().__init__(
            orientation="vertical",
            padding=dp(18),
            spacing=dp(8),
            **kwargs
        )
        self.size_hint_y = None
        self.height = dp(174)
        self.radius = dp(24)

        row = BoxLayout(size_hint_y=None, height=dp(48), spacing=dp(10))
        self.status = StatusDot(size_hint=(None, None), size=(dp(42), dp(42)))
        row.add_widget(self.status)

        texts = BoxLayout(orientation="vertical")
        self.title = PremiumLabel(
            text=ar("LG webOS TV"),
            bold=True,
            font_size=sp(17),
        )
        self.subtitle = PremiumLabel(
            text=ar("غير متصل"),
            tone="secondary",
            font_size=sp(12),
        )
        texts.add_widget(self.title)
        texts.add_widget(self.subtitle)
        row.add_widget(texts)
        self.add_widget(row)

        self.search_button = PremiumButton(
            text=ar("البحث عن تلفزيون"),
            accent_key="elevated",
            on_release=lambda b: App.get_running_app().start_discovery(),
        )
        self.add_widget(self.search_button)

    def update_state(self, state, message=""):
        self.status.set_state(state)
        if state == "connected":
            app = App.get_running_app()
            self.title.text = ar(app.lg.name or "LG webOS TV")
            self.subtitle.text = ar("متصل")
            self.subtitle.tone = "connected"
            self.search_button.text = ar("تغيير التلفزيون")
        elif state == "connecting":
            self.subtitle.text = ar("جارٍ الاتصال...")
            self.subtitle.tone = "secondary"
        elif state == "searching":
            self.subtitle.text = ar("جارٍ البحث على الشبكة...")
            self.subtitle.tone = "secondary"
        elif state == "error":
            self.subtitle.text = ar("تعذر الاتصال")
            self.subtitle.tone = "danger"
        else:
            self.subtitle.text = ar("غير متصل")
            self.subtitle.tone = "secondary"
            self.search_button.text = ar("البحث عن تلفزيون")
        self.subtitle.apply_theme()


class HomeScreen(BaseScreen):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)

        outer = BoxLayout(
            orientation="vertical",
            padding=[dp(18), dp(25), dp(18), dp(16)],
            spacing=dp(15),
        )
        self.add_widget(outer)

        self.header = PremiumLabel(
            text=ar("LG REMOTE"),
            tone="muted",
            font_size=sp(11),
            bold=True,
            size_hint_y=None,
            height=dp(28),
        )
        outer.add_widget(self.header)

        self.greeting = PremiumLabel(
            text="",
            font_size=sp(27),
            bold=True,
            size_hint_y=None,
            height=dp(55),
        )
        outer.add_widget(self.greeting)

        self.tv_card = TVCard()
        outer.add_widget(self.tv_card)

        control_card = SurfaceBox(
            orientation="vertical",
            padding=dp(16),
            spacing=dp(10),
            size_hint_y=None,
            height=dp(185),
        )
        control_card.add_widget(
            PremiumLabel(
                text=ar("الوصول السريع"),
                font_size=sp(16),
                bold=True,
                size_hint_y=None,
                height=dp(30),
            )
        )

        row = BoxLayout(spacing=dp(9))
        row.add_widget(
            PremiumButton(
                text=ar("الريموت"),
                on_release=lambda b: self.open_remote(),
            )
        )
        row.add_widget(
            PremiumButton(
                text=ar("الإعدادات"),
                on_release=lambda b: App.get_running_app().navigate("settings"),
            )
        )
        control_card.add_widget(row)

        outer.add_widget(control_card)
        outer.add_widget(Widget())

        self.nav = BottomNav(active="home")
        outer.add_widget(self.nav)

    def refresh(self):
        name = App.get_running_app().config_data.get("user_name", "")
        self.greeting.text = ar(("مرحبًا، " + name) if name else "مرحبًا")

    def on_pre_enter(self, *args):
        self.refresh()
        self.header.opacity = 0
        self.greeting.opacity = 0
        self.tv_card.opacity = 0
        self.nav.opacity = 0
        Animation(opacity=1, duration=0.25).start(self.header)
        Clock.schedule_once(
            lambda dt: Animation(opacity=1, duration=0.28).start(self.greeting),
            0.06,
        )
        Clock.schedule_once(
            lambda dt: Animation(opacity=1, duration=0.32).start(self.tv_card),
            0.12,
        )
        Clock.schedule_once(
            lambda dt: Animation(opacity=1, duration=0.25).start(self.nav),
            0.20,
        )

    def open_remote(self):
        app = App.get_running_app()
        if not app.lg.connected:
            app.toast("ابحث عن التلفزيون واتصل به أولاً")
            return
        app.navigate("remote")


class DeviceCard(SurfaceBox):
