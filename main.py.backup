try:
    import arabic_reshaper
    from bidi.algorithm import get_display

    ARABIC_SUPPORT = True
except ImportError:
    arabic_reshaper = None
    get_display = None
    ARABIC_SUPPORT = False
    print(
        "[ARABIC] ثبّت arabic-reshaper و python-bidi لتشكيل العربية "
        "بصورة صحيحة داخل Kivy."
    )


_ARABIC_RE = re.compile(
    r"[\u0600-\u06ff\u0750-\u077f\u08a0-\u08ff]"
)


def display_text(value: Any) -> str:
    """
    Source strings remain natural UTF-8 Arabic.

    arabic_reshaper joins Arabic glyphs.
    python-bidi converts the logical string to visual order.

    IMPORTANT:
    Labels using the result must NOT also request RTL/base_direction,
    otherwise the text may be reversed twice.
    """
    if value is None:
        return ""

    text = str(value)

    if not _ARABIC_RE.search(text):
        return text

    if not ARABIC_SUPPORT:
        return text

    try:
        return get_display(arabic_reshaper.reshape(text))
    except Exception:
        return text


ar = display_text


def safe_ui(callback: Callable, *args, **kwargs) -> None:
    Clock.schedule_once(lambda _dt: callback(*args, **kwargs), 0)


def mask_ip(ip: str) -> str:
    parts = str(ip).split(".")
    if len(parts) == 4:
        return f"{parts[0]}.{parts[1]}.xxx.{parts[3]}"
    return "غير معروف"


def now_ms() -> int:
    return int(time.monotonic() * 1000)


DEFAULT_CAPABILITIES = {
    "pointer": False,
    "keyboard": False,
    "volume": False,
    "channels": False,
    "apps": False,
    "microphone": False,
    "media": False,
}


@dataclass
class TVDevice:
    name: str
    ip: str
    port: int = 3001
    device_id: str = ""
    manufacturer: str = "LG Electronics"
    model: str = ""
    protocol: str = "LG webOS SSAP"
    availability: bool = True
    capabilities: Dict[str, bool] = field(
        default_factory=lambda: dict(DEFAULT_CAPABILITIES)
    )

    def identity(self) -> str:
        if self.device_id:
            return self.device_id.lower().strip()

        return (
            f"{self.ip}|{self.manufacturer}|{self.protocol}"
        ).lower()

    def to_dict(self) -> dict:
        return asdict(self)

    @classmethod
    def from_dict(cls, data: dict) -> "TVDevice":
        caps = dict(DEFAULT_CAPABILITIES)
        caps.update(data.get("capabilities") or {})

        return cls(
            name=str(data.get("name") or "LG webOS TV"),
            ip=str(data.get("ip") or ""),
            port=int(data.get("port") or 3001),
            device_id=str(data.get("device_id") or ""),
            manufacturer=str(
                data.get("manufacturer") or "LG Electronics"
            ),
            model=str(data.get("model") or ""),
            protocol=str(data.get("protocol") or "LG webOS SSAP"),
            availability=bool(data.get("availability", True)),
            capabilities=caps,
        )


class AndroidClientKeyStore:
    """
    On Android the client-key is encrypted using an AES key generated in
    Android Keystore. Only ciphertext + IV are stored in SharedPreferences.

    No client-key is written to settings.json.
    """

    ALIAS = "fahd_lg_client_key_aes"

    def __init__(self):
        from jnius import autoclass

        self.autoclass = autoclass
        PythonActivity = autoclass(
            "org.kivy.android.PythonActivity"
        )
        self.context = PythonActivity.mActivity
        self.prefs = self.context.getSharedPreferences(
            "fahd_secure_keys", 0
        )

    def _secret_key(self):
        KeyStore = self.autoclass("java.security.KeyStore")
        ks = KeyStore.getInstance("AndroidKeyStore")
        ks.load(None)

        if ks.containsAlias(self.ALIAS):
            return ks.getKey(self.ALIAS, None)

        KeyGenerator = self.autoclass(
            "javax.crypto.KeyGenerator"
        )
        KeyProperties = self.autoclass(
            "android.security.keystore.KeyProperties"
        )
        KeyGenParameterSpecBuilder = self.autoclass(
            "android.security.keystore.KeyGenParameterSpec$Builder"
        )

        generator = KeyGenerator.getInstance(
            KeyProperties.KEY_ALGORITHM_AES,
            "AndroidKeyStore",
        )

        purposes = (
            KeyProperties.PURPOSE_ENCRYPT
            | KeyProperties.PURPOSE_DECRYPT
        )

        builder = KeyGenParameterSpecBuilder(
            self.ALIAS, purposes
        )
        builder.setBlockModes(
            [KeyProperties.BLOCK_MODE_GCM]
        )
        builder.setEncryptionPaddings(
            [KeyProperties.ENCRYPTION_PADDING_NONE]
        )
        generator.init(builder.build())
        return generator.generateKey()

    def _pref_name(self, device_id: str) -> str:
        import hashlib

        return "tv_" + hashlib.sha256(
            device_id.encode("utf-8")
        ).hexdigest()

    def get(self, device_id: str) -> Optional[str]:
        if not device_id:
            return None

        encoded = self.prefs.getString(
            self._pref_name(device_id), None
        )
        if not encoded:
            return None

        try:
            Base64 = self.autoclass(
                "android.util.Base64"
            )
            Cipher = self.autoclass("javax.crypto.Cipher")
            GCMParameterSpec = self.autoclass(
                "javax.crypto.spec.GCMParameterSpec"
            )

            raw = bytes(
                Base64.decode(encoded, Base64.NO_WRAP)
            )
            iv_len = raw[0]
            iv = raw[1:1 + iv_len]
            ciphertext = raw[1 + iv_len:]

            cipher = Cipher.getInstance(
                "AES/GCM/NoPadding"
            )
            cipher.init(
                Cipher.DECRYPT_MODE,
                self._secret_key(),
                GCMParameterSpec(128, iv),
            )
            plain = bytes(cipher.doFinal(ciphertext))
            return plain.decode("utf-8")
        except Exception:
            return None

    def set(self, device_id: str, client_key: str) -> None:
        if not device_id or not client_key:
            return

        Base64 = self.autoclass("android.util.Base64")
        Cipher = self.autoclass("javax.crypto.Cipher")

        cipher = Cipher.getInstance("AES/GCM/NoPadding")
        cipher.init(
            Cipher.ENCRYPT_MODE,
            self._secret_key(),
        )

        iv = bytes(cipher.getIV())
        ciphertext = bytes(
            cipher.doFinal(client_key.encode("utf-8"))
        )

        data = bytes([len(iv)]) + iv + ciphertext
        encoded = str(
            Base64.encodeToString(
                data, Base64.NO_WRAP
            )
        )

        self.prefs.edit().putString(
            self._pref_name(device_id),
            encoded,
        ).apply()

    def delete(self, device_id: str) -> None:
        self.prefs.edit().remove(
            self._pref_name(device_id)
        ).apply()


class WindowsClientKeyStore:
    """
    Development fallback only.

    This separate file prevents client-key leakage into settings.json, but it
    is NOT equivalent to Android Keystore secure storage.
    """

    def __init__(self, path: Path):
        self.path = path
        self.lock = threading.Lock()

    def _load(self) -> dict:
        try:
            if not self.path.exists():
                return {}
            return json.loads(
                self.path.read_text(encoding="utf-8")
            )
        except (OSError, ValueError, TypeError):
            return {}

    def _save(self, data: dict) -> None:
        self.path.parent.mkdir(
            parents=True, exist_ok=True
        )

        fd, tmp_name = tempfile.mkstemp(
            prefix=".keys-",
            suffix=".json",
            dir=str(self.path.parent),
        )
        os.close(fd)

        tmp = Path(tmp_name)

        try:
            tmp.write_text(
                json.dumps(
                    data,
                    ensure_ascii=False,
                    indent=2,
                ),
                encoding="utf-8",
            )
            os.replace(str(tmp), str(self.path))
        finally:
            if tmp.exists():
                try:
                    tmp.unlink()
                except OSError:
                    pass

    def get(self, device_id: str) -> Optional[str]:
        with self.lock:
            return self._load().get(device_id)

    def set(self, device_id: str, client_key: str) -> None:
        if not device_id or not client_key:
            return

        with self.lock:
            data = self._load()
            data[device_id] = client_key
            self._save(data)

    def delete(self, device_id: str) -> None:
        with self.lock:
            data = self._load()
            data.pop(device_id, None)
            self._save(data)


class SettingsManager:
    DEFAULTS = {
        "pointer_sensitivity": 1.0,
        "pointer_acceleration": 1.25,
        "pointer_dead_zone": 1.5,
        "pointer_max_speed": 80.0,
        "auto_reconnect": True,
        "saved_tvs": [],
        "selected_tv": "",
        "language": "ar",
        "haptic": True,
        "sound": False,
    }

    def __init__(self):
        app_data = (
            Path(os.environ.get("APPDATA", APP_DIR))
            / "FahdRemote"
            if not ANDROID
            else Path(
                os.environ.get(
                    "ANDROID_PRIVATE", str(APP_DIR)
                )
            )
        )

        self.root = app_data
        self.path = self.root / "settings.json"
        self.data = dict(self.DEFAULTS)
        self.lock = threading.Lock()
        self.load()

        if ANDROID:
            try:
                self.key_store = AndroidClientKeyStore()
            except Exception as exc:
                print(
                    "[SECURITY] Android Keystore unavailable:",
                    exc,
                )
                self.key_store = WindowsClientKeyStore(
                    self.root / "client_keys_fallback.json"
                )
        else:
            self.key_store = WindowsClientKeyStore(
                self.root / "client_keys_windows_dev.json"
            )

    def load(self) -> None:
        with self.lock:
            try:
                raw = json.loads(
                    self.path.read_text(encoding="utf-8")
                )
                if not isinstance(raw, dict):
                    raise ValueError("invalid settings")

                clean = dict(self.DEFAULTS)
                clean.update(raw)

                # Never accept/migrate a client-key into settings.
                clean.pop("client-key", None)
                clean.pop("client_key", None)

                self.data = clean

            except FileNotFoundError:
                self.data = dict(self.DEFAULTS)
            except (
                OSError,
                ValueError,
                TypeError,
                json.JSONDecodeError,
            ):
                self.data = dict(self.DEFAULTS)

    def save(self) -> None:
        with self.lock:
            self.root.mkdir(
                parents=True, exist_ok=True
            )

            safe_data = dict(self.data)
            safe_data.pop("client-key", None)
            safe_data.pop("client_key", None)

            fd, tmp_name = tempfile.mkstemp(
                prefix=".settings-",
                suffix=".json",
                dir=str(self.root),
            )
            os.close(fd)
            tmp = Path(tmp_name)

            try:
                tmp.write_text(
                    json.dumps(
                        safe_data,
                        ensure_ascii=False,
                        indent=2,
                    ),
                    encoding="utf-8",
                )
                os.replace(str(tmp), str(self.path))
            finally:
                if tmp.exists():
                    try:
                        tmp.unlink()
                    except OSError:
                        pass

    def get(self, key: str, default=None):
        return self.data.get(key, default)

    def set(self, key: str, value: Any) -> None:
        self.data[key] = value
        self.save()

    def saved_devices(self) -> List[TVDevice]:
        result = []
        for item in self.data.get("saved_tvs", []):
            try:
                device = TVDevice.from_dict(item)
                if device.ip:
                    result.append(device)
            except Exception:
                continue
        return result

    def save_device(self, device: TVDevice) -> None:
        devices = {
            d.identity(): d
            for d in self.saved_devices()
        }
        devices[device.identity()] = device

        self.data["saved_tvs"] = [
            d.to_dict() for d in devices.values()
        ]
        self.data["selected_tv"] = device.identity()
        self.save()

    def forget_device(self, device: TVDevice) -> None:
        identity = device.identity()

        self.data["saved_tvs"] = [
            d.to_dict()
            for d in self.saved_devices()
            if d.identity() != identity
        ]

        if self.data.get("selected_tv") == identity:
            self.data["selected_tv"] = ""

        self.key_store.delete(identity)
        self.save()

    def get_client_key(
        self, device: TVDevice
    ) -> Optional[str]:
        return self.key_store.get(device.identity())

    def save_client_key(
        self,
        device: TVDevice,
        client_key: str,
    ) -> None:
        self.key_store.set(
            device.identity(), client_key
        )


class TVDiscovery:
    ADDRESS = ("239.255.255.250", 1900)
    ST = "urn:lge-com:service:webos-second-screen:1"

    def __init__(
        self,
        on_device: Callable[[TVDevice], None],
        on_finished: Callable[[], None],
    ):
        self.on_device = on_device
        self.on_finished = on_finished
        self.stop_event = threading.Event()
        self.thread = None
        self.seen = set()

    def start(self, timeout: float = 4.0) -> None:
        self.stop()
        self.stop_event.clear()
        self.seen.clear()

        self.thread = threading.Thread(
            target=self._run,
            args=(timeout,),
            daemon=True,
            name="LG-SSDP-Discovery",
        )
        self.thread.start()

    def stop(self) -> None:
        self.stop_event.set()

    @staticmethod
    def parse_ssdp(data: bytes) -> dict:
        try:
            text = data.decode(
                "utf-8", errors="replace"
            )
        except Exception:
            return {}

        lines = text.replace("\r\n", "\n").split("\n")
        result = {}

        for line in lines[1:]:
            if ":" not in line:
                continue
            key, value = line.split(":", 1)
            result[key.strip().lower()] = value.strip()

        return result

    def _description(
        self, location: str
    ) -> Dict[str, str]:
        result = {}

        if not location.startswith(
            ("http://", "https://")
        ):
            return result

        try:
            request = urllib.request.Request(
                location,
                headers={"User-Agent": "FAHD Smart Remote"},
            )
            with urllib.request.urlopen(
                request, timeout=1.5
            ) as response:
                data = response.read(512 * 1024)

            root = ET.fromstring(data)

            for element in root.iter():
                tag = element.tag.split("}")[-1]
                text = (
                    element.text.strip()
                    if element.text
                    else ""
                )

                if tag in (
                    "friendlyName",
                    "manufacturer",
                    "modelName",
                    "UDN",
                ):
                    result[tag] = text

        except Exception:
            return {}

        return result

    @staticmethod
    def _tcp_available(ip: str) -> bool:
        for port in (3001, 3000):
            try:
                with socket.create_connection(
                    (ip, port), timeout=0.4
                ):
                    return True
            except OSError:
                continue
        return False

    def _run(self, timeout: float) -> None:
        sock = None

        try:
            sock = socket.socket(
                socket.AF_INET,
                socket.SOCK_DGRAM,
                socket.IPPROTO_UDP,
            )
            sock.settimeout(0.35)

            message = (
                "M-SEARCH * HTTP/1.1\r\n"
                "HOST: 239.255.255.250:1900\r\n"
                'MAN: "ssdp:discover"\r\n'
                "MX: 2\r\n"
                f"ST: {self.ST}\r\n"
                "\r\n"
            ).encode("ascii")

            # Sending more than once improves discovery reliability without
            # scanning arbitrary network ports.
            sock.sendto(message, self.ADDRESS)
            sock.sendto(message, self.ADDRESS)

            deadline = time.monotonic() + timeout

            while (
                not self.stop_event.is_set()
                and time.monotonic() < deadline
            ):
                try:
                    packet, addr = sock.recvfrom(65535)
                except socket.timeout:
                    continue
                except OSError:
                    break

                headers = self.parse_ssdp(packet)
                if not headers:
                    continue

                st = headers.get("st", "")
                usn = headers.get("usn", "")
                server = headers.get("server", "")
                location = headers.get("location", "")

                combined = (
                    st + " " + usn + " " + server
                ).lower()

                if (
                    "webos" not in combined
                    and "lge" not in combined
                    and self.ST.lower() not in combined
                ):
                    continue

                ip = addr[0]
                desc = self._description(location)

                manufacturer = desc.get(
                    "manufacturer", "LG Electronics"
                )

                if (
                    manufacturer
                    and "lg" not in manufacturer.lower()
                    and "lge" not in manufacturer.lower()
                ):
                    continue

                device_id = (
                    desc.get("UDN")
                    or usn.split("::", 1)[0]
                    or ip
                )

                identity = (
                    device_id.lower()
                    if device_id
                    else f"{ip}|lg|webos"
                )

                if identity in self.seen:
                    continue
                self.seen.add(identity)

                device = TVDevice(
                    name=desc.get(
                        "friendlyName", "LG webOS TV"
                    ),
                    ip=ip,
                    port=3001,
                    device_id=device_id,
                    manufacturer=manufacturer,
                    model=desc.get("modelName", ""),
                    protocol="LG webOS SSAP",
                    availability=self._tcp_available(ip),
                )

                safe_ui(self.on_device, device)

        except OSError:
            pass
        finally:
            if sock:
                try:
                    sock.close()
                except OSError:
                    pass

            safe_ui(self.on_finished)


class PendingRequest:
    def __init__(self):
        self.event = threading.Event()
        self.response = None


class TVConnection:
    REGISTRATION_PERMISSIONS = [
        "LAUNCH",
        "LAUNCH_WEBAPP",
        "APP_TO_APP",
        "CONTROL_AUDIO",
        "CONTROL_DISPLAY",
        "CONTROL_INPUT_JOYSTICK",
        "CONTROL_INPUT_MEDIA_RECORDING",
        "CONTROL_INPUT_MEDIA_PLAYBACK",
        "CONTROL_INPUT_TV",
        "CONTROL_POWER",
        "READ_APP_STATUS",
        "READ_CURRENT_CHANNEL",
        "READ_INPUT_DEVICE_LIST",
        "READ_INSTALLED_APPS",
        "READ_LGE_SDX",
        "READ_NETWORK_STATE",
        "READ_RUNNING_APPS",
        "READ_TV_CHANNEL_LIST",
        "WRITE_NOTIFICATION_TOAST",
        "WRITE_SETTINGS",
        "WRITE_INPUT_SOCKET",
    ]

    def __init__(
        self,
        device: TVDevice,
        settings: SettingsManager,
        state_callback: Optional[Callable] = None,
    ):
        self.device = device
        self.settings = settings
        self.state_callback = state_callback

        self.ws = None
        self.ws_lock = threading.Lock()
        self.pending_lock = threading.Lock()
        self.pending: Dict[str, PendingRequest] = {}

        self.connected = False
        self.registered = False
        self.closing = threading.Event()

        self.receiver_thread = None
        self.request_counter = 0
        self.last_error_category = ""
        self.latency_ms = None

    def _state(
        self,
        state: str,
        error: str = "",
    ) -> None:
        self.last_error_category = error
        if self.state_callback:
            safe_ui(
                self.state_callback,
                state,
                error,
            )

    def _next_id(self, prefix="req") -> str:
        with self.pending_lock:
            self.request_counter += 1
            return (
                f"{prefix}_{self.request_counter}_"
                f"{uuid.uuid4().hex[:8]}"
            )

    def _url_candidates(self):
        return [
            f"wss://{self.device.ip}:3001/",
            f"ws://{self.device.ip}:3000/",
        ]

    def connect(self, timeout: float = 8.0) -> bool:
        self.close(notify=False)
        self.closing.clear()
        self._state("connecting")

        last_exception = None

        for url in self._url_candidates():
            if self.closing.is_set():
                return False

            try:
                ws = websocket.create_connection(
                    url,
                    timeout=3.0,
                    sslopt={
                        "cert_reqs": ssl.CERT_NONE,
                        "check_hostname": False,
                    },
                    enable_multithread=True,
                )
                ws.settimeout(1.0)

                self.ws = ws
                self.connected = True

                self.receiver_thread = threading.Thread(
                    target=self._receiver_loop,
                    daemon=True,
                    name="LG-SSAP-Receiver",
                )
                self.receiver_thread.start()

                if self._register(timeout):
                    self.registered = True
                    self.device.port = (
                        3001 if url.startswith("wss") else 3000
                    )
                    self._state("connected")
                    return True

                self.close(notify=False)

            except Exception as exc:
                last_exception = exc
                self.close(notify=False)

        self.last_error_category = (
            "timeout"
            if isinstance(last_exception, TimeoutError)
            else "connection"
        )
        self._state(
            "disconnected",
            self.last_error_category,
        )
        return False

    def _registration_payload(self) -> dict:
        client_key = self.settings.get_client_key(
            self.device
        )

        signed = {
            "appId": "com.fahd.remote",
            "vendorId": "com.fahd.remote",
            "localizedAppNames": {
                "": "FAHD Smart Remote"
            },
            "localizedVendorNames": {
                "": "FAHD"
            },
            "permissions": list(
                self.REGISTRATION_PERMISSIONS
            ),
        }

        manifest = {
            "manifestVersion": 1,
            "appVersion": "1.0.0",
            "signed": signed,
            "permissions": list(
                self.REGISTRATION_PERMISSIONS
            ),
        }

        payload = {
            "forcePairing": False,
            "pairingType": "PROMPT",
            "manifest": manifest,
        }

        if client_key:
            payload["client-key"] = client_key

        return payload

    def _register(self, timeout: float) -> bool:
        request_id = self._next_id("register")
        pending = PendingRequest()

        with self.pending_lock:
            self.pending[request_id] = pending

        packet = {
            "id": request_id,
            "type": "register",
            "payload": self._registration_payload(),
        }

        try:
            self._send_json(packet)
        except Exception:
            with self.pending_lock:
                self.pending.pop(request_id, None)
            return False

        if not pending.event.wait(timeout):
            with self.pending_lock:
                self.pending.pop(request_id, None)
            self.last_error_category = "timeout"
            return False

        response = pending.response or {}
        response_type = response.get("type")
        payload = response.get("payload") or {}

        if response_type != "registered":
            self.last_error_category = (
                "pairing"
                if response_type == "error"
                else "protocol"
            )
            return False

        client_key = payload.get("client-key")
        if client_key:
            self.settings.save_client_key(
                self.device, client_key
            )

        return True

    def _send_json(self, packet: dict) -> None:
        text = json.dumps(
            packet,
            ensure_ascii=False,
            separators=(",", ":"),
        )

        with self.ws_lock:
            if not self.ws or not self.connected:
                raise ConnectionError("not connected")
            self.ws.send(text)

    def request(
        self,
        uri: str,
        payload: Optional[dict] = None,
        timeout: float = 4.0,
    ) -> dict:
        if not self.connected:
            raise ConnectionError("disconnected")

        request_id = self._next_id()
        pending = PendingRequest()

        with self.pending_lock:
            self.pending[request_id] = pending

        packet = {
            "id": request_id,
            "type": "request",
            "uri": uri,
        }

        if payload is not None:
            packet["payload"] = payload

        start = time.monotonic()

        try:
            self._send_json(packet)
        except Exception:
            with self.pending_lock:
                self.pending.pop(request_id, None)
            raise

        if not pending.event.wait(timeout):
            with self.pending_lock:
                self.pending.pop(request_id, None)
            self.last_error_category = "timeout"
            raise TimeoutError(uri)

        self.latency_ms = int(
            (time.monotonic() - start) * 1000
        )

        response = pending.response

        if not isinstance(response, dict):
            self.last_error_category = "malformed_response"
            raise ValueError("malformed response")

        if response.get("type") == "error":
            self.last_error_category = "tv_error"
            raise RuntimeError("TV returned an error")

        payload_out = response.get("payload")

        if isinstance(payload_out, dict):
            if payload_out.get("returnValue") is False:
                self.last_error_category = "tv_error"
                raise RuntimeError("request rejected")

        return response

    def _receiver_loop(self) -> None:
        while (
            not self.closing.is_set()
            and self.connected
        ):
            try:
                raw = self.ws.recv()

                if not raw:
                    raise ConnectionError("closed")

                try:
                    message = json.loads(raw)
                except (ValueError, TypeError):
                    self.last_error_category = (
                        "malformed_response"
                    )
                    continue

                if not isinstance(message, dict):
                    continue

                request_id = message.get("id")

                if request_id:
                    with self.pending_lock:
                        pending = self.pending.pop(
                            request_id, None
                        )

                    if pending:
                        pending.response = message
                        pending.event.set()

            except websocket.WebSocketTimeoutException:
                continue
            except Exception:
                break

        if not self.closing.is_set():
            self.connected = False
            self.registered = False
            self._release_pending()
            self._state("disconnected", "connection")

    def _release_pending(self) -> None:
        with self.pending_lock:
            pending_items = list(
                self.pending.values()
            )
            self.pending.clear()

        for pending in pending_items:
            pending.response = {
                "type": "error",
                "error": "disconnected",
            }
            pending.event.set()

    def close(self, notify: bool = True) -> None:
        self.closing.set()
        self.connected = False
        self.registered = False

        ws = self.ws
        self.ws = None

        if ws:
            try:
                ws.close()
            except Exception:
                pass

        self._release_pending()

        if notify:
            self._state("disconnected")


class BaseTVController:
    def connect(self) -> bool:
        raise NotImplementedError

    def disconnect(self) -> None:
        raise NotImplementedError

    def send_command(self, command: str) -> bool:
        raise NotImplementedError


class LGWebOSController(BaseTVController):
    COMMANDS = {
        "power_off": (
            "ssap://system/turnOff",
            None,
        ),
        "volume_up": (
            "ssap://audio/volumeUp",
            None,
        ),
        "volume_down": (
            "ssap://audio/volumeDown",
            None,
        ),
        "mute": (
            "ssap://audio/setMute",
            {"mute": True},
        ),
        "home": (
            "ssap://system.launcher/open",
            {"target": "home"},
        ),
        "back": (
            "ssap://com.webos.service.networkinput/"
            "sendSpecialKey",
            {"key": "BACK"},
        ),
        "menu": (
            "ssap://com.webos.service.networkinput/"
            "sendSpecialKey",
            {"key": "MENU"},
        ),
        "guide": (
            "ssap://tv/openChannelGuide",
            None,
        ),
        "settings": (
            "ssap://system.launcher/launch",
            {"id": "com.webos.app.settings"},
        ),
        "channel_up": (
            "ssap://tv/channelUp",
            None,
        ),
        "channel_down": (
            "ssap://tv/channelDown",
            None,
        ),
        "play": (
            "ssap://media.controls/play",
            None,
        ),
        "pause": (
            "ssap://media.controls/pause",
            None,
        ),
        "stop": (
            "ssap://media.controls/stop",
            None,
        ),
        "rewind": (
            "ssap://media.controls/rewind",
            None,
        ),
        "fast_forward": (
            "ssap://media.controls/fastForward",
            None,
        ),
    }

    POINTER_BUTTONS = {
        "up": "UP",
        "down": "DOWN",
        "left": "LEFT",
        "right": "RIGHT",
        "ok": "ENTER",
        "back": "BACK",
        "home": "HOME",
    }

    APP_IDS = {
        "YouTube": "youtube.leanback.v4",
        "Netflix": "netflix",
        "Prime Video": "amazon",
    }

    def __init__(
        self,
        device: TVDevice,
        settings: SettingsManager,
        state_callback=None,
        capability_callback=None,
    ):
        self.device = device
        self.settings = settings
        self.capability_callback = capability_callback

        self.connection = TVConnection(
            device,
            settings,
            state_callback=state_callback,
        )

        self.pointer = PointerController(
            self,
            settings,
        )
        self.keyboard = KeyboardController(self)

    def connect(self) -> bool:
        result = self.connection.connect()

        if result:
            self.probe_capabilities()

        return result

    def disconnect(self) -> None:
        self.pointer.stop()
        self.connection.close()

    def request(
        self,
        uri: str,
        payload: Optional[dict] = None,
        timeout: float = 4.0,
    ) -> dict:
        return self.connection.request(
            uri, payload, timeout
        )

    def send_command(self, command: str) -> bool:
        if command in self.POINTER_BUTTONS:
            if not self.device.capabilities.get(
                "pointer"
            ):
                return False
            return self.pointer.button(
                self.POINTER_BUTTONS[command]
            )

        item = self.COMMANDS.get(command)
        if not item:
            return False

        capability = self._command_capability(command)

        if capability and not self.device.capabilities.get(
            capability, False
        ):
            return False

        uri, payload = item
        self.request(uri, payload)
        return True

    @staticmethod
    def _command_capability(
        command: str,
    ) -> Optional[str]:
        if command.startswith("volume") or command == "mute":
            return "volume"
        if command.startswith("channel"):
            return "channels"
        if command in (
            "play",
            "pause",
            "stop",
            "rewind",
            "fast_forward",
        ):
            return "media"
        return None

    def probe_capabilities(self) -> None:
        caps = dict(DEFAULT_CAPABILITIES)

        probes = [
            (
                "volume",
                "ssap://audio/getVolume",
                None,
            ),
            (
                "channels",
                "ssap://tv/getCurrentChannel",
                None,
            ),
            (
                "apps",
                "ssap://com.webos.applicationManager/"
                "listLaunchPoints",
                None,
            ),
            (
                "keyboard",
                "ssap://com.webos.service.ime/"
                "getEditorInfo",
                None,
            ),
            (
                "media",
                "ssap://media.controls/getMediaState",
                None,
            ),
        ]

        for capability, uri, payload in probes:
            try:
                self.request(
                    uri,
                    payload,
                    timeout=2.5,
                )
                caps[capability] = True
            except Exception:
                caps[capability] = False

        try:
            response = self.request(
                "ssap://com.webos.service.networkinput/"
                "getPointerInputSocket",
                timeout=3.0,
            )
            payload = response.get("payload") or {}
            socket_path = payload.get("socketPath")

            if socket_path:
                self.pointer.set_socket_path(
                    socket_path
                )
                caps["pointer"] = self.pointer.start()
        except Exception:
            caps["pointer"] = False

        caps["microphone"] = False

        self.device.capabilities = caps
        self.settings.save_device(self.device)

        if self.capability_callback:
            safe_ui(
                self.capability_callback,
                dict(caps),
            )

    def launch_app(self, name: str) -> bool:
        if not self.device.capabilities.get("apps"):
            return False

        app_id = self.APP_IDS.get(name)
        if not app_id:
            return False

        self.request(
            "ssap://system.launcher/launch",
            {"id": app_id},
        )
        return True


class PointerController:
    def __init__(
        self,
        lg: LGWebOSController,
        settings: SettingsManager,
    ):
        self.lg = lg
        self.settings = settings

        self.socket_path = ""
        self.ws = None
        self.ws_lock = threading.Lock()

        self.pending_dx = 0.0
        self.pending_dy = 0.0
        self.pending_lock = threading.Lock()

        self.dragging = False
        self.running = threading.Event()
        self.worker = None
        self.interval = 0.03

    def set_socket_path(self, path: str) -> None:
        self.socket_path = str(path or "")

    def start(self) -> bool:
        if not self.socket_path:
            return False

        self.stop()

        try:
            self.ws = websocket.create_connection(
                self.socket_path,
                timeout=3.0,
                sslopt={
                    "cert_reqs": ssl.CERT_NONE,
                    "check_hostname": False,
                },
                enable_multithread=True,
            )
        except Exception:
            self.ws = None
            return False

        self.running.set()
        self.worker = threading.Thread(
            target=self._worker_loop,
            daemon=True,
            name="LG-Pointer-Worker",
        )
        self.worker.start()
        return True

    def transform(
        self, dx: float, dy: float
    ) -> tuple[float, float]:
        dead_zone = float(
            self.settings.get(
                "pointer_dead_zone", 1.5
            )
        )
        sensitivity = float(
            self.settings.get(
                "pointer_sensitivity", 1.0
            )
        )
        acceleration = max(
            1.0,
            float(
                self.settings.get(
                    "pointer_acceleration", 1.25
                )
            ),
        )
        max_speed = max(
            1.0,
            float(
                self.settings.get(
                    "pointer_max_speed", 80.0
                )
            ),
        )

        magnitude = math.hypot(dx, dy)

        if magnitude <= dead_zone:
            return 0.0, 0.0

        scale = sensitivity * (
            1.0
            + (magnitude / 20.0)
            * (acceleration - 1.0)
        )

        dx *= scale
        dy *= scale

        speed = math.hypot(dx, dy)
        if speed > max_speed:
            ratio = max_speed / speed
            dx *= ratio
            dy *= ratio

        return dx, dy

    def move(self, dx: float, dy: float) -> bool:
        if not self.running.is_set():
            return False

        dx, dy = self.transform(dx, dy)
        if dx == 0 and dy == 0:
            return True

        with self.pending_lock:
            self.pending_dx += dx
            self.pending_dy += dy

        return True

    def _worker_loop(self) -> None:
        while self.running.is_set():
            time.sleep(self.interval)

            with self.pending_lock:
                dx = self.pending_dx
                dy = self.pending_dy
                self.pending_dx = 0.0
                self.pending_dy = 0.0

            if not dx and not dy:
                continue

            packet = (
                "type:move\n"
                f"dx:{int(round(dx))}\n"
                f"dy:{int(round(dy))}\n"
                f"down:{1 if self.dragging else 0}\n\n"
            )

            if not self._send(packet):
                self.running.clear()
                self.lg.device.capabilities[
                    "pointer"
                ] = False
                break

    def _send(self, packet: str) -> bool:
        with self.ws_lock:
            if not self.ws:
                return False
            try:
                self.ws.send(packet)
                return True
            except Exception:
                return False

    def click(self) -> bool:
        return self._send("type:click\n\n")

    def button(self, name: str) -> bool:
        safe = re.sub(
            r"[^A-Z0-9_]",
            "",
            str(name).upper(),
        )
        if not safe:
            return False

        return self._send(
            f"type:button\nname:{safe}\n\n"
        )

    def set_drag(self, active: bool) -> None:
        self.dragging = bool(active)

    def scroll(self, dy: float) -> bool:
        if not self.running.is_set():
            return False

        dy = max(-100, min(100, int(dy)))

        return self._send(
            "type:scroll\n"
            "dx:0\n"
            f"dy:{dy}\n\n"
        )

    def stop(self) -> None:
        self.running.clear()

        with self.pending_lock:
            self.pending_dx = 0.0
            self.pending_dy = 0.0

        ws = self.ws
        self.ws = None

        if ws:
            try:
                ws.close()
            except Exception:
                pass


class KeyboardController:
    def __init__(self, lg: LGWebOSController):
        self.lg = lg
        self.lock = threading.Lock()
        self.last_text = None
        self.last_text_time = 0.0

    def insert_text(self, text: str) -> bool:
        if not self.lg.device.capabilities.get(
            "keyboard"
        ):
            return False

        if not text:
            return False

        timestamp = time.monotonic()

        with self.lock:
            if (
                text == self.last_text
                and timestamp - self.last_text_time < 0.12
            ):
                return False

            self.last_text = text
            self.last_text_time = timestamp

        self.lg.request(
            "ssap://com.webos.service.ime/insertText",
            {
                "text": text,
                "replace": 0,
            },
        )
        return True

    def backspace(self) -> bool:
        if not self.lg.device.capabilities.get(
            "keyboard"
        ):
            return False

        self.lg.request(
            "ssap://com.webos.service.ime/"
            "deleteCharacters",
            {"count": 1},
        )
        return True
class RemoteController:
    def __init__(
        self,
        settings: SettingsManager,
        state_callback=None,
        capability_callback=None,
        error_callback=None,
    ):
        self.settings = settings
        self.state_callback = state_callback
        self.capability_callback = capability_callback
        self.error_callback = error_callback

        self.device: Optional[TVDevice] = None
        self.controller: Optional[
            LGWebOSController
        ] = None

        self.jobs = queue.Queue()
        self.stop_event = threading.Event()

        self.worker = threading.Thread(
            target=self._loop,
            daemon=True,
            name="Remote-Command-Worker",
        )
        self.worker.start()

    def _loop(self):
        while not self.stop_event.is_set():
            try:
                job = self.jobs.get(timeout=0.2)
            except queue.Empty:
                continue

            if job is None:
                break

            callback, args = job

            try:
                callback(*args)
            except TimeoutError:
                self._error("timeout")
            except ConnectionError:
                self._error("connection")
                self._maybe_reconnect()
            except ValueError:
                self._error("malformed_response")
            except Exception:
                self._error("tv_error")

    def _error(self, category: str):
        if self.error_callback:
            safe_ui(
                self.error_callback,
                category,
            )

    def enqueue(self, fn: Callable, *args):
        if not self.stop_event.is_set():
            self.jobs.put((fn, args))

    def connect(self, device: TVDevice):
        self.enqueue(self._connect, device)

    def _connect(self, device: TVDevice):
        if self.controller:
            self.controller.disconnect()

        self.device = device
        self.controller = LGWebOSController(
            device,
            self.settings,
            state_callback=self.state_callback,
            capability_callback=self.capability_callback,
        )

        if self.controller.connect():
            self.settings.save_device(device)

    def _maybe_reconnect(self):
        if (
            self.stop_event.is_set()
            or not self.device
            or not self.settings.get(
                "auto_reconnect", True
            )
        ):
            return

        if self.state_callback:
            safe_ui(
                self.state_callback,
                "reconnecting",
                "connection",
            )

        time.sleep(1.5)

        if self.stop_event.is_set():
            return

        self._connect(self.device)

    def command(self, command: str):
        if self.controller:
            self.enqueue(
                self.controller.send_command,
                command,
            )

    def launch_app(self, app_name: str):
        if self.controller:
            self.enqueue(
                self.controller.launch_app,
                app_name,
            )

    def pointer_move(self, dx, dy):
        controller = self.controller
        if (
            controller
            and controller.device.capabilities.get(
                "pointer"
            )
        ):
            controller.pointer.move(dx, dy)

    def pointer_click(self):
        controller = self.controller
        if controller:
            self.enqueue(
                controller.pointer.click
            )

    def keyboard_text(self, text: str):
        controller = self.controller
        if controller:
            self.enqueue(
                controller.keyboard.insert_text,
                text,
            )

    def keyboard_backspace(self):
        controller = self.controller
        if controller:
            self.enqueue(
                controller.keyboard.backspace
            )

    def close(self):
        self.stop_event.set()
        self.jobs.put(None)

        if self.controller:
            self.controller.disconnect()


class ArabicLabel(Label):
    def __init__(self, natural_text="", **kwargs):
        text = kwargs.pop("text", natural_text)

        super().__init__(
            text=display_text(text),
            font_name=FONT_NAME,
            color=kwargs.pop(
                "color", (0.92, 0.93, 0.95, 1)
            ),
            **kwargs,
        )

        self.bind(
            size=self._update_text_size
        )

    def set_natural_text(self, text: str):
        self.text = display_text(text)

    def _update_text_size(self, *_):
        self.text_size = (
            max(0, self.width - dp(4)),
            None,
        )


class GlassButton(Button):
    natural_text = StringProperty("")
    accent = ListProperty(
        [0.10, 0.12, 0.15, 1]
    )
    outline = ListProperty(
        [0.28, 0.30, 0.34, 0.55]
    )

    def __init__(self, natural_text="", **kwargs):
        kwargs.setdefault("background_normal", "")
        kwargs.setdefault("background_down", "")
        kwargs.setdefault(
            "background_color", (0, 0, 0, 0)
        )
        kwargs.setdefault("font_name", FONT_NAME)
        kwargs.setdefault(
            "color", (0.93, 0.94, 0.96, 1)
        )
        kwargs.setdefault("font_size", "14sp")

        super().__init__(**kwargs)

        self.natural_text = natural_text
        self.text = display_text(natural_text)

        with self.canvas.before:
            self.bg_color = Color(*self.accent)
            self.bg_rect = RoundedRectangle(
                pos=self.pos,
                size=self.size,
                radius=[dp(15)],
            )

            self.outline_color = Color(
                *self.outline
            )
            self.outline_line = Line(
                rounded_rectangle=(
                    self.x,
                    self.y,
                    self.width,
                    self.height,
                    dp(15),
                ),
                width=1,
            )

        self.bind(
            pos=self._update_canvas,
            size=self._update_canvas,
            accent=self._update_canvas,
            outline=self._update_canvas,
            state=self._update_canvas,
        )

    def set_natural_text(self, text: str):
        self.natural_text = text
        self.text = display_text(text)

    def _update_canvas(self, *_):
        factor = 0.82 if self.state == "down" else 1.0

        self.bg_color.rgba = (
            self.accent[0] * factor,
            self.accent[1] * factor,
            self.accent[2] * factor,
            self.accent[3],
        )

        self.outline_color.rgba = self.outline
        self.bg_rect.pos = self.pos
        self.bg_rect.size = self.size

        self.outline_line.rounded_rectangle = (
            self.x,
            self.y,
            self.width,
            self.height,
            dp(15),
        )


class Card(BoxLayout):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)

        with self.canvas.before:
            self.card_color = Color(
                0.055, 0.065, 0.08, 0.98
            )
            self.card_rect = RoundedRectangle(
                pos=self.pos,
                size=self.size,
                radius=[dp(20)],
            )

            self.card_outline_color = Color(
                0.25, 0.27, 0.31, 0.4
            )
            self.card_outline_line = Line(
                rounded_rectangle=(
                    self.x,
                    self.y,
                    self.width,
                    self.height,
                    dp(20),
                ),
                width=1,
            )

        self.bind(
            pos=self._update_card,
            size=self._update_card,
        )

    def _update_card(self, *_):
        self.card_rect.pos = self.pos
        self.card_rect.size = self.size

        self.card_outline_line.rounded_rectangle = (
            self.x,
            self.y,
            self.width,
            self.height,
            dp(20),
        )


class DPadButton(GlassButton):
    def __init__(
        self,
        command: str,
        remote: RemoteController,
        **kwargs,
    ):
        self.command = command
        self.remote = remote
        self.initial_event = None
        self.repeat_event = None

        super().__init__(**kwargs)

    def on_touch_down(self, touch):
        if (
            self.disabled
            or not self.collide_point(*touch.pos)
        ):
            return super().on_touch_down(touch)

        if not touch.grab_current:
            touch.grab(self)

        self.state = "down"
        self.remote.command(self.command)

        self.initial_event = Clock.schedule_once(
            self._start_repeat,
            0.38,
        )
        return True

    def _start_repeat(self, _dt):
        if self.state != "down":
            return

        self.repeat_event = Clock.schedule_interval(
            self._repeat,
            0.12,
        )

    def _repeat(self, _dt):
        if self.state != "down":
            return False

        self.remote.command(self.command)
        return True

    def on_touch_up(self, touch):
        if touch.grab_current is self:
            touch.ungrab(self)
            self._cancel_repeat()
            self.state = "normal"
            return True

        return super().on_touch_up(touch)

    def _cancel_repeat(self):
        if self.initial_event:
            self.initial_event.cancel()
            self.initial_event = None

        if self.repeat_event:
            self.repeat_event.cancel()
            self.repeat_event = None


class TouchPad(Widget):
    remote = ObjectProperty(None)

    def __init__(self, **kwargs):
        super().__init__(**kwargs)

        self.active_touch = None
        self.last_pos = None
        self.total_motion = 0.0
        self.drag_event = None
        self.drag_started = False

        with self.canvas.before:
            self.pad_color = Color(
                0.045, 0.052, 0.063, 1
            )
            self.pad_rect = RoundedRectangle(
                pos=self.pos,
                size=self.size,
                radius=[dp(25)],
            )

            self.pad_outline_color = Color(
                0.30, 0.32, 0.36, 0.45
            )
            self.pad_outline_line = Line(
                rounded_rectangle=(
                    self.x,
                    self.y,
                    self.width,
                    self.height,
                    dp(25),
                ),
                width=1,
            )

        self.bind(
            pos=self._redraw,
            size=self._redraw,
        )

    def _redraw(self, *_):
        self.pad_rect.pos = self.pos
        self.pad_rect.size = self.size
        self.pad_outline_line.rounded_rectangle = (
            self.x,
            self.y,
            self.width,
            self.height,
            dp(25),
        )

    def on_touch_down(self, touch):
        if not self.collide_point(*touch.pos):
            return super().on_touch_down(touch)

        if self.active_touch is not None:
            return True

        self.active_touch = touch
        touch.grab(self)
        self.last_pos = touch.pos
        self.total_motion = 0.0
        self.drag_started = False

        self.drag_event = Clock.schedule_once(
            self._begin_drag,
            0.48,
        )
        return True

    def _begin_drag(self, _dt):
        if (
            self.active_touch is not None
            and self.total_motion < dp(8)
        ):
            controller = (
                self.remote.controller
                if self.remote
                else None
            )
            if controller:
                controller.pointer.set_drag(True)
                self.drag_started = True

    def on_touch_move(self, touch):
        if (
            touch.grab_current is not self
            or touch is not self.active_touch
        ):
            return super().on_touch_move(touch)

        if not self.last_pos:
            self.last_pos = touch.pos
            return True

        dx = touch.x - self.last_pos[0]
        # Kivy Y grows upward; pointer feels more natural preserving sign.
        dy = touch.y - self.last_pos[1]

        self.total_motion += math.hypot(dx, dy)
        self.last_pos = touch.pos

        if self.total_motion > dp(8) and self.drag_event:
            self.drag_event.cancel()
            self.drag_event = None

        if self.remote:
            self.remote.pointer_move(dx, dy)

        return True

    def on_touch_up(self, touch):
        if (
            touch.grab_current is not self
            or touch is not self.active_touch
        ):
            return super().on_touch_up(touch)

        touch.ungrab(self)

        if self.drag_event:
            self.drag_event.cancel()
            self.drag_event = None

        controller = (
            self.remote.controller
            if self.remote
            else None
        )

        if self.drag_started and controller:
            controller.pointer.set_drag(False)
        elif self.total_motion < dp(8):
            if self.remote:
                self.remote.pointer_click()

        self.active_touch = None
        self.last_pos = None
        self.drag_started = False
        return True


class BottomNavigation(BoxLayout):
    def __init__(self, app_ref, **kwargs):
        super().__init__(
            orientation="horizontal",
            size_hint_y=None,
            height=dp(62),
            spacing=dp(8),
            padding=[dp(8), dp(7)],
            **kwargs,
        )

        for title, screen in (
            ("الرئيسية", "home"),
            ("الريموت", "remote"),
            ("الإعدادات", "settings"),
        ):
            button = GlassButton(
                natural_text=title,
                accent=[0.06, 0.07, 0.085, 1],
            )
            button.bind(
                on_release=lambda _btn, s=screen:
                app_ref.show_screen(s)
            )
            self.add_widget(button)


class FahdScreen(Screen):
    def __init__(self, app_ref, **kwargs):
        super().__init__(**kwargs)
        self.app_ref = app_ref

        with self.canvas.before:
            self.background_color = Color(
                0.018, 0.021, 0.028, 1
            )
            self.background_rect = RoundedRectangle(
                pos=self.pos,
                size=self.size,
                radius=[0],
            )

        self.bind(
            pos=self._update_background,
            size=self._update_background,
        )

    def _update_background(self, *_):
        self.background_rect.pos = self.pos
        self.background_rect.size = self.size


class HomeScreen(FahdScreen):
    def __init__(self, app_ref, **kwargs):
        super().__init__(
            app_ref, name="home", **kwargs
        )

        root = BoxLayout(
            orientation="vertical",
            padding=[dp(18), dp(16), dp(18), dp(8)],
            spacing=dp(10),
        )

        header = BoxLayout(
            orientation="vertical",
            size_hint_y=None,
            height=dp(100),
            spacing=0,
        )

        title = ArabicLabel(
            "فهد",
            font_size="28sp",
            bold=True,
            halign="right",
            valign="middle",
        )

        subtitle = ArabicLabel(
            "FAHD SMART REMOTE",
            font_size="11sp",
            color=(0.57, 0.60, 0.66, 1),
            halign="right",
        )

        tagline = ArabicLabel(
            "تحكم ذكي، ببساطة",
            font_size="17sp",
            color=(0.80, 0.82, 0.86, 1),
            halign="right",
        )

        header.add_widget(title)
        header.add_widget(subtitle)
        header.add_widget(tagline)

        root.add_widget(header)

        self.tv_card = Card(
            orientation="vertical",
            padding=dp(18),
            spacing=dp(3),
            size_hint_y=None,
            height=dp(128),
        )

        self.tv_name = ArabicLabel(
            "لا يوجد تلفزيون متصل",
            font_size="17sp",
            bold=True,
            halign="right",
        )

        self.tv_model = ArabicLabel(
            "LG webOS",
            font_size="12sp",
            color=(0.58, 0.61, 0.67, 1),
            halign="right",
        )

        self.tv_state = ArabicLabel(
            "غير متصل",
            font_size="13sp",
            color=(0.60, 0.62, 0.66, 1),
            halign="right",
        )

        self.tv_card.add_widget(self.tv_name)
        self.tv_card.add_widget(self.tv_model)
        self.tv_card.add_widget(self.tv_state)

        root.add_widget(self.tv_card)

        open_remote = GlassButton(
            natural_text="فتح الريموت",
            size_hint_y=None,
            height=dp(54),
            accent=[0.12, 0.14, 0.17, 1],
        )
        open_remote.bind(
            on_release=lambda *_:
            app_ref.show_screen("remote")
        )
        root.add_widget(open_remote)

        self.discovery_button = GlassButton(
            natural_text="البحث عن تلفزيون",
            size_hint_y=None,
            height=dp(52),
            accent=[0.075, 0.085, 0.105, 1],
        )
        self.discovery_button.bind(
            on_release=lambda *_:
            app_ref.start_discovery()
        )
        root.add_widget(self.discovery_button)

        saved_title = ArabicLabel(
            "الأجهزة المحفوظة",
            size_hint_y=None,
            height=dp(34),
            font_size="14sp",
            color=(0.70, 0.72, 0.76, 1),
            halign="right",
        )
        root.add_widget(saved_title)

        self.devices_scroll = ScrollView(
            do_scroll_x=False
        )

        self.devices_box = BoxLayout(
            orientation="vertical",
            size_hint_y=None,
            spacing=dp(8),
        )
        self.devices_box.bind(
            minimum_height=self.devices_box.setter(
                "height"
            )
        )

        self.devices_scroll.add_widget(
            self.devices_box
        )
        root.add_widget(self.devices_scroll)

        root.add_widget(
            BottomNavigation(app_ref)
        )

        self.add_widget(root)

    def show_device(self, device: TVDevice):
        self.tv_name.set_natural_text(device.name)
        self.tv_model.set_natural_text(
            device.model or "LG webOS"
        )

    def set_state(
        self, state: str, error: str = ""
    ):
        states = {
            "connecting": (
                "جارٍ الاتصال...",
                (0.72, 0.74, 0.78, 1),
            ),
            "connected": (
                "متصل",
                (0.30, 0.82, 0.48, 1),
            ),
            "reconnecting": (
                "تم فصل الاتصال، جارٍ إعادة المحاولة",
                (0.75, 0.64, 0.38, 1),
            ),
            "disconnected": (
                "غير متصل",
                (0.62, 0.64, 0.68, 1),
            ),
        }

        text, color = states.get(
            state, states["disconnected"]
        )
        self.tv_state.set_natural_text(text)
        self.tv_state.color = color

    def refresh_devices(
        self, devices: List[TVDevice]
    ):
        self.devices_box.clear_widgets()

        if not devices:
            label = ArabicLabel(
                "لا توجد أجهزة محفوظة",
                size_hint_y=None,
                height=dp(42),
                font_size="13sp",
                color=(0.50, 0.52, 0.56, 1),
                halign="right",
            )
            self.devices_box.add_widget(label)
            return

        for device in devices:
            title = device.name
            if device.model:
                title += f" - {device.model}"

            button = GlassButton(
                natural_text=title,
                size_hint_y=None,
                height=dp(52),
                accent=[0.065, 0.075, 0.09, 1],
            )

            button.bind(
                on_release=lambda _btn, d=device:
                self.app_ref.connect_device(d)
            )

            self.devices_box.add_widget(button)


class RemoteScreen(FahdScreen):
    def __init__(self, app_ref, **kwargs):
        super().__init__(
            app_ref, name="remote", **kwargs
        )

        root = BoxLayout(
            orientation="vertical",
            spacing=dp(8),
            padding=[dp(14), dp(12), dp(14), dp(6)],
        )

        header = BoxLayout(
            orientation="horizontal",
            size_hint_y=None,
            height=dp(58),
            spacing=dp(8),
        )

        info = BoxLayout(
            orientation="vertical"
        )
        self.title = ArabicLabel(
            "فهد",
            font_size="21sp",
            bold=True,
            halign="right",
        )
        self.device_label = ArabicLabel(
            "لا يوجد تلفزيون متصل",
            font_size="11sp",
            color=(0.58, 0.60, 0.65, 1),
            halign="right",
        )
        info.add_widget(self.title)
        info.add_widget(self.device_label)

        power = GlassButton(
            natural_text="إيقاف",
            size_hint_x=None,
            width=dp(74),
            accent=[0.25, 0.055, 0.06, 1],
            outline=[0.45, 0.10, 0.10, 0.8],
        )
        power.bind(
            on_release=lambda *_:
            app_ref.remote.command("power_off")
        )

        header.add_widget(info)
        header.add_widget(power)
        root.add_widget(header)

        scroll = ScrollView(
            do_scroll_x=False
        )

        content = BoxLayout(
            orientation="vertical",
            size_hint_y=None,
            spacing=dp(10),
            padding=[0, dp(3), 0, dp(8)],
        )
        content.bind(
            minimum_height=content.setter("height")
        )

        self.touchpad = TouchPad(
            remote=app_ref.remote,
            size_hint_y=None,
            height=dp(195),
        )
        content.add_widget(self.touchpad)

        self.pointer_warning = ArabicLabel(
            "لوحة اللمس غير متاحة حتى يتأكد دعم التلفزيون",
            size_hint_y=None,
            height=dp(26),
            font_size="11sp",
            color=(0.54, 0.56, 0.60, 1),
            halign="center",
        )
        content.add_widget(self.pointer_warning)

        dpad = FloatLayout(
            size_hint_y=None,
            height=dp(190),
        )

        positions = [
            (
                "أعلى",
                "up",
                0.35,
                0.66,
            ),
            (
                "يسار",
                "left",
                0.08,
                0.34,
            ),
            (
                "OK",
                "ok",
                0.35,
                0.34,
            ),
            (
                "يمين",
                "right",
                0.62,
                0.34,
            ),
            (
                "أسفل",
                "down",
                0.35,
                0.02,
            ),
        ]

        for text, command, x, y in positions:
            button = DPadButton(
                command=command,
                remote=app_ref.remote,
                natural_text=text,
                size_hint=(0.30, 0.30),
                pos_hint={"x": x, "y": y},
                accent=[0.08, 0.095, 0.115, 1],
            )
            dpad.add_widget(button)

        content.add_widget(dpad)

        self.controls = BoxLayout(
            orientation="vertical",
            size_hint_y=None,
            spacing=dp(7),
        )
        self.controls.bind(
            minimum_height=self.controls.setter(
                "height"
            )
        )
        content.add_widget(self.controls)

        scroll.add_widget(content)
        root.add_widget(scroll)

        root.add_widget(
            BottomNavigation(app_ref)
        )

        self.add_widget(root)
        self.rebuild_controls(
            dict(DEFAULT_CAPABILITIES)
        )

    def _row(self, entries):
        row = BoxLayout(
            orientation="horizontal",
            spacing=dp(7),
            size_hint_y=None,
            height=dp(48),
        )

        for title, command in entries:
            button = GlassButton(
                natural_text=title,
                accent=[0.075, 0.087, 0.105, 1],
            )
            button.bind(
                on_release=lambda _btn, c=command:
                self.app_ref.remote.command(c)
            )
            row.add_widget(button)

        self.controls.add_widget(row)

    def rebuild_controls(self, caps: dict):
        self.controls.clear_widgets()

        self.touchpad.disabled = not caps.get(
            "pointer", False
        )
        self.pointer_warning.opacity = (
            0 if caps.get("pointer") else 1
        )

        if caps.get("volume") or caps.get(
            "channels"
        ):
            row_entries = []

            if caps.get("volume"):
                row_entries.append(
                    ("VOL+", "volume_up")
                )

            row_entries.append(
                ("HOME", "home")
            )

            if caps.get("channels"):
                row_entries.append(
                    ("CH+", "channel_up")
                )

            self._row(row_entries)

            second = []

            if caps.get("volume"):
                second.append(("MUTE", "mute"))

            second.append(("BACK", "back"))

            if caps.get("channels"):
                second.append(
                    ("GUIDE", "guide")
                )

            self._row(second)

            third = []

            if caps.get("volume"):
                third.append(
                    ("VOL-", "volume_down")
                )

            third.append(("MENU", "menu"))

            if caps.get("channels"):
                third.append(
                    ("CH-", "channel_down")
                )

            self._row(third)

        if caps.get("media"):
            self._row(
                [
                    ("REW", "rewind"),
                    ("PLAY", "play"),
                    ("PAUSE", "pause"),
                ]
            )
            self._row(
                [
                    ("STOP", "stop"),
                    ("FF", "fast_forward"),
                ]
            )

        extra = BoxLayout(
            orientation="horizontal",
            spacing=dp(7),
            size_hint_y=None,
            height=dp(48),
        )

        if caps.get("keyboard"):
            keyboard = GlassButton(
                natural_text="لوحة المفاتيح"
            )
            keyboard.bind(
                on_release=lambda *_:
                self.app_ref.open_keyboard()
            )
            extra.add_widget(keyboard)

        if caps.get("apps"):
            apps = GlassButton(
                natural_text="التطبيقات"
            )
            apps.bind(
                on_release=lambda *_:
                self.app_ref.toggle_apps()
            )
            extra.add_widget(apps)

        if extra.children:
            self.controls.add_widget(extra)

        if caps.get("apps"):
            self.apps_row = BoxLayout(
                orientation="horizontal",
                spacing=dp(7),
                size_hint_y=None,
                height=dp(48),
            )

            for name in (
                "Netflix",
                "Prime Video",
                "YouTube",
            ):
                button = GlassButton(
                    natural_text=name
                )
                button.bind(
                    on_release=lambda _btn, n=name:
                    self.app_ref.remote.launch_app(n)
                )
                self.apps_row.add_widget(button)

            self.apps_row.opacity = 0
            self.apps_row.disabled = True
            self.controls.add_widget(
                self.apps_row
            )
        else:
            self.apps_row = None


class SettingsScreen(FahdScreen):
    def __init__(self, app_ref, **kwargs):
        super().__init__(
            app_ref, name="settings", **kwargs
        )

        root = BoxLayout(
            orientation="vertical",
            padding=[dp(18), dp(18), dp(18), dp(8)],
            spacing=dp(12),
        )

        title = ArabicLabel(
            "الإعدادات",
            size_hint_y=None,
            height=dp(54),
            font_size="23sp",
            bold=True,
            halign="right",
        )
        root.add_widget(title)

        self.diagnostics = ArabicLabel(
            "البروتوكول: LG webOS SSAP\n"
            "الحالة: غير متصل",
            font_size="13sp",
            color=(0.70, 0.72, 0.76, 1),
            halign="right",
            valign="top",
        )
        root.add_widget(self.diagnostics)

        root.add_widget(
            BottomNavigation(app_ref)
        )

        self.add_widget(root)

    def update_diagnostics(
        self,
        device: Optional[TVDevice],
        state: str,
        connection: Optional[TVConnection],
    ):
        if not device:
            text = (
                "البروتوكول: LG webOS SSAP\n"
                "الحالة: غير متصل"
            )
        else:
            latency = (
                f"{connection.latency_ms} ms"
                if connection
                and connection.latency_ms is not None
                else "غير متاح"
            )

            capabilities = ", ".join(
                name
                for name, enabled
                in device.capabilities.items()
                if enabled
            ) or "لا توجد قدرات مؤكدة"

            text = (
                f"البروتوكول: {device.protocol}\n"
                f"IP: {mask_ip(device.ip)}\n"
                f"الموديل: {device.model or 'غير معروف'}\n"
                f"الحالة: {state}\n"
                f"Latency: {latency}\n"
                f"Capabilities: {capabilities}"
            )

        self.diagnostics.set_natural_text(text)


class KeyboardOverlay(FloatLayout):
    def __init__(self, app_ref, **kwargs):
        super().__init__(**kwargs)
        self.app_ref = app_ref

        with self.canvas.before:
            self.overlay_color = Color(
                0.01, 0.012, 0.016, 0.96
            )
            self.overlay_rect = RoundedRectangle(
                pos=self.pos,
                size=self.size,
            )

        self.bind(
            pos=self._update_bg,
            size=self._update_bg,
        )

        card = Card(
            orientation="vertical",
            spacing=dp(10),
            padding=dp(14),
            size_hint=(0.92, None),
            height=dp(180),
            pos_hint={
                "center_x": 0.5,
                "center_y": 0.60,
            },
        )

        title = ArabicLabel(
            "إدخال النص إلى التلفزيون",
            size_hint_y=None,
            height=dp(32),
            font_size="15sp",
            halign="right",
        )

        self.input = TextInput(
            multiline=False,
            font_name=FONT_NAME,
            font_size="17sp",
            background_normal="",
            background_active="",
            background_color=(
                0.035, 0.04, 0.05, 1
            ),
            foreground_color=(0.94, 0.95, 0.97, 1),
            cursor_color=(0.8, 0.82, 0.86, 1),
            padding=[dp(12), dp(12)],
        )

        row = BoxLayout(
            orientation="horizontal",
            spacing=dp(8),
            size_hint_y=None,
            height=dp(46),
        )

        close = GlassButton(
            natural_text="إغلاق"
        )
        send = GlassButton(
            natural_text="إرسال"
        )

        close.bind(
            on_release=lambda *_:
            self.close()
        )
        send.bind(
            on_release=lambda *_:
            self.send_text()
        )

        row.add_widget(close)
        row.add_widget(send)

        card.add_widget(title)
        card.add_widget(self.input)
        card.add_widget(row)

        self.add_widget(card)
        self.add_widget(card)

        Clock.schedule_once(
          lambda _dt: setattr(self.input, "focus", True),
          0.15,
)                    

    def _update_bg(self, *_):
        self.overlay_rect.pos = self.pos
        self.overlay_rect.size = self.size

    def send_text(self):
        text = self.input.text
        if text:
            self.app_ref.remote.keyboard_text(text)
            self.input.text = ""

    def close(self):
        self.input.focus = False
        if self.parent:
            self.parent.remove_widget(self)


class FahdApp(App):
    title = "فهد"

    ERROR_TEXTS = {
        "connection": "تعذر الاتصال بالتلفزيون.",
        "timeout": "انتهت مهلة الاتصال.",
        "pairing": (
            "يرجى الموافقة على طلب الاتصال "
            "الظاهر على شاشة التلفزيون."
        ),
        "malformed_response": (
            "حدث خطأ في رد التلفزيون."
        ),
        "tv_error": "هذه الميزة غير مدعومة.",
    }

    def build(self):
        self.settings_manager = SettingsManager()

        self.remote = RemoteController(
            self.settings_manager,
            state_callback=self.on_connection_state,
            capability_callback=self.on_capabilities,
            error_callback=self.on_remote_error,
        )

        self.discovery = TVDiscovery(
            self.on_discovered_device,
            self.on_discovery_finished,
        )

        self.discovered: Dict[str, TVDevice] = {}
        self.current_state = "disconnected"

        root = FloatLayout()

        self.screen_manager = ScreenManager()
        self.home_screen = HomeScreen(self)
        self.remote_screen = RemoteScreen(self)
        self.settings_screen = SettingsScreen(self)

        self.screen_manager.add_widget(
            self.home_screen
        )
        self.screen_manager.add_widget(
            self.remote_screen
        )
        self.screen_manager.add_widget(
            self.settings_screen
        )

        root.add_widget(self.screen_manager)
        self.root_layout = root

        saved = self.settings_manager.saved_devices()
        self.home_screen.refresh_devices(saved)

        selected = self.settings_manager.get(
            "selected_tv", ""
        )

        for device in saved:
            if device.identity() == selected:
                self.home_screen.show_device(device)
                self.remote_screen.device_label.set_natural_text(
                    device.name
                )
                break

        return root

    def show_screen(self, name: str):
        self.screen_manager.current = name

    def toast(self, natural_text: str):
        label = ArabicLabel(
            natural_text,
            size_hint=(0.88, None),
            height=dp(48),
            pos_hint={
                "center_x": 0.5,
                "y": 0.09,
            },
            halign="center",
            valign="middle",
            font_size="13sp",
        )

        with label.canvas.before:
            color = Color(
                0.08, 0.09, 0.11, 0.97
            )
            rect = RoundedRectangle(
                pos=label.pos,
                size=label.size,
                radius=[dp(14)],
            )

        def update(*_):
            rect.pos = label.pos
            rect.size = label.size

        label.bind(
            pos=update,
            size=update,
        )

        self.root_layout.add_widget(label)

        def remove(_dt):
            if label.parent:
                label.parent.remove_widget(label)

        Clock.schedule_once(remove, 2.4)

    def start_discovery(self):
        self.discovered.clear()
        self.home_screen.discovery_button.disabled = True
        self.home_screen.discovery_button.set_natural_text(
            "جارٍ البحث..."
        )
        self.discovery.start(timeout=4.0)

    def on_discovered_device(
        self, device: TVDevice
    ):
        self.discovered[device.identity()] = device

        combined = {
            d.identity(): d
            for d in self.settings_manager.saved_devices()
        }
        combined.update(self.discovered)

        self.home_screen.refresh_devices(
            list(combined.values())
        )

    def on_discovery_finished(self):
        self.home_screen.discovery_button.disabled = False
        self.home_screen.discovery_button.set_natural_text(
            "البحث عن تلفزيون"
        )

        if not self.discovered:
            self.toast("لم يتم العثور على أجهزة.")

    def connect_device(self, device: TVDevice):
        self.home_screen.show_device(device)
        self.remote_screen.device_label.set_natural_text(
            device.name
        )
        self.remote.connect(device)

    def on_connection_state(
        self,
        state: str,
        error: str = "",
    ):
        self.current_state = state
        self.home_screen.set_state(state, error)

        connection = (
            self.remote.controller.connection
            if self.remote.controller
            else None
        )

        self.settings_screen.update_diagnostics(
            self.remote.device,
            state,
            connection,
        )

        if (
            state == "disconnected"
            and error
            and error in self.ERROR_TEXTS
        ):
            self.toast(self.ERROR_TEXTS[error])

    def on_capabilities(self, caps: dict):
        self.remote_screen.rebuild_controls(caps)

        if self.remote.device:
            self.settings_manager.save_device(
                self.remote.device
            )
            self.home_screen.refresh_devices(
                self.settings_manager.saved_devices()
            )

    def on_remote_error(self, category: str):
        message = self.ERROR_TEXTS.get(
            category,
            "تعذر تنفيذ الأمر.",
        )
        self.toast(message)

    def open_keyboard(self):
        controller = self.remote.controller

        if (
            not controller
            or not controller.device.capabilities.get(
                "keyboard"
            )
        ):
            self.toast(
                "إدخال النص غير مدعوم على هذا التلفزيون "
                "أو في التطبيق الحالي."
            )
            return

        overlay = KeyboardOverlay(self)
        self.root_layout.add_widget(overlay)

    def toggle_apps(self):
        row = self.remote_screen.apps_row

        if not row:
            self.toast("هذه الميزة غير مدعومة.")
            return

        row.disabled = not row.disabled
        row.opacity = 0 if row.disabled else 1

    def on_stop(self):
        try:
            self.discovery.stop()
        except Exception:
            pass

        try:
            self.remote.close()
        except Exception:
            pass


if __name__ == "__main__":
    FahdApp().run()